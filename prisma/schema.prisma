datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  AUTHOR
  ADMIN
  SUPER_ADMIN
}

enum AuthorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_SUBMITTED
  UNDER_REVIEW
  PENDING_ADMIN_APPROVAL
  APPROVED
  ACTIVATED
  COMPLETED
  REJECTED
}

enum AccessStatus {
  PENDING
  APPROVED
  REVOKED
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  TELECEL_CASH
  AIRTEL_TIGO_MONEY
  VISA
  MASTERCARD
  BANK_TRANSFER
}

enum Language {
  EN
  AR
}

enum MediaType {
  VIDEO
  AUDIO
}

model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  emailVerified     DateTime?
  passwordHash      String
  role              Role         @default(USER)
  authorStatus      AuthorStatus @default(PENDING) // Tracks "Sell Your Books" approval status
  preferredLanguage Language     @default(EN)
  countryId         String?
  country           Country?     @relation(fields: [countryId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders                Order[]
  cart                  Cart?
  enrollments           Enrollment[]
  notifications         Notification[]
  downloadLogs          DownloadLog[]
  courseProgress        CourseProgress[]
  manuscriptSubmissions ManuscriptSubmission[]
  books                 Book[]       @relation("AuthorBooks") // Books uploaded by this author
}

model Country {
  id             String        @id @default(uuid())
  code           String        @unique // e.g., "GH", "US"
  name           String
  currencyCode   String // e.g., "GHS", "USD"
  currencySymbol String // e.g., "GH₵", "$"
  users          User[]
  exchangeRate   ExchangeRate?
}

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique // e.g., "GHS"
  rateToUSD    Decimal  @db.Decimal(12, 6) // 1 USD = X Local Currency
  updatedAt    DateTime @updatedAt

  countryId String  @unique
  country   Country @relation(fields: [countryId], references: [id])
}

model Category {
  id      String   @id @default(uuid())
  nameEn  String
  nameAr  String
  slug    String   @unique
  books   Book[]
  courses Course[]
}

model Book {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  slug          String   @unique
  descriptionEn String
  descriptionAr String
  priceUSD      Decimal  @db.Decimal(10, 2)
  coverImageUrl String
  r2FileKey     String // Private Cloudflare R2 Key
  isFeatured    Boolean  @default(false)
  isNewRelease  Boolean  @default(true)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  
  authorId      String?  // Linked to User table (Author)
  author        User?    @relation("AuthorBooks", fields: [authorId], references: [id])

  createdAt     DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Course {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  slug          String   @unique
  descriptionEn String
  descriptionAr String
  isPaid        Boolean  @default(false)
  priceUSD      Decimal  @default(0.00) @db.Decimal(10, 2)
  thumbnailUrl  String
  isPublished   Boolean  @default(false)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())

  sections    CourseSection[]
  enrollments Enrollment[]
}

model CourseSection {
  id       String    @id @default(uuid())
  titleEn  String
  titleAr  String
  order    Int
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]
}

model Lecture {
  id            String         @id @default(uuid())
  titleEn       String
  titleAr       String
  mediaType     MediaType      @default(VIDEO)
  mediaUrl      String // Cloudflare Stream/R2 URL
  durationSec   Int            @default(0)
  isFreePreview Boolean        @default(false)
  order         Int
  sectionId     String
  section       CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress      CourseProgress[]
}

model Enrollment {
  id        String       @id @default(uuid())
  userId    String
  courseId  String
  status    AccessStatus @default(PENDING)
  user      User         @relation(fields: [userId], references: [id])
  course    Course       @relation(fields: [courseId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, courseId])
}

model CourseProgress {
  id          String   @id @default(uuid())
  userId      String
  lectureId   String
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  lecture Lecture @relation(fields: [lectureId], references: [id])

  @@unique([userId, lectureId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  bookId   String
  quantity Int    @default(1)
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id])
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  totalUSD        Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @db.Decimal(10, 2)
  currencyCode    String
  exchangeRate    Decimal       @db.Decimal(12, 6)
  status          OrderStatus   @default(ORDER_PLACED)
  paymentMethod   PaymentMethod
  paymentRef      String?
  paymentProofUrl String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items        OrderItem[]
  receipt      Receipt?
  downloadLogs DownloadLog[]
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  bookId   String
  priceUSD Decimal @db.Decimal(10, 2)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book    @relation(fields: [bookId], references: [id])
}

model Receipt {
  id        String   @id @default(uuid())
  receiptNo String   @unique
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  pdfUrl    String
  issuedAt  DateTime @default(now())
}

model DownloadLog {
  id           String   @id @default(uuid())
  userId       String
  orderId      String
  bookId       String
  downloadedAt DateTime @default(now())
  ipAddress    String

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ==========================================
// PHASE 4: PUBLISHING SERVICES & AUTHOR PORTAL
// ==========================================

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTE_GENERATED
  QUOTE_ACCEPTED
  IN_PRODUCTION
  PUBLISHED
  REJECTED
}

model ManuscriptSubmission {
  id             String           @id @default(uuid())
  authorId       String
  title          String
  genre          String
  description    String
  manuscriptUrl  String
  services       String[]
  status         SubmissionStatus @default(SUBMITTED)
  quoteAmount    Float?
  quoteDetails   String?
  assignedEditor String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user       User                 @relation(fields: [authorId], references: [id])
  revisions  ManuscriptRevision[]
}

model ManuscriptRevision {
  id           String   @id @default(uuid())
  submissionId String
  fileUrl      String
  notes        String?
  createdAt    DateTime @default(now())

  submission ManuscriptSubmission @relation(fields: [submissionId], references: [id])
}

// ==========================================
// PHASE 5: NEWSLETTER & CAMPAIGNS
// ==========================================

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model NewsletterCampaign {
  id       String   @id @default(uuid())
  subject  String
  content  String
  category String
  sentAt   DateTime @default(now())
}