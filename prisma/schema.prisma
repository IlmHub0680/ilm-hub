enum CalendarStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// The institution's official Academic Calendar — a versioned, staff-managed
// document (Academic Records / Registrar), never hard-coded in the UI. Only
// one calendar is ever PUBLISHED at a time (the one every portal reads);
// publishing a new one archives whichever was previously published, so
// past academic calendars are always kept, never overwritten or deleted.
model AcademicCalendar {
  id                String         @id @default(cuid())
  academicYearLabel String
  hijriYearLabel    String
  status            CalendarStatus @default(DRAFT)
  publishedAt       DateTime?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  createdBy User                    @relation(fields: [createdById], references: [id])
  entries   AcademicCalendarEntry[]

  @@index([status])
}

// One row of the published calendar's Procedure / Gregorian Date / Hijri
// Date table. `section` groups rows under a semester heading (e.g. "First
// Semester", "Second Semester", "Summer Semester") — the final row of the
// last section is conventionally "Start of the New Academic Year".
model AcademicCalendarEntry {
  id            String @id @default(cuid())
  calendarId    String
  section       String
  procedure     String
  gregorianDate String
  hijriDate     String
  sortOrder     Int    @default(0)

  calendar AcademicCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId])
}

// Institution holidays shown on the public Academic Calendar
// alongside the semester procedure tables (Model 28) -- managed by
// Academic Records staff at /academic-records-dashboard/holidays.
// Deliberately independent of AcademicCalendar's draft/publish
// workflow: a holiday is live as soon as it's saved and active,
// the same as the site's other simple admin-managed lists.
model InstitutionHoliday {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  note      String?
  order     Int      @default(0)
