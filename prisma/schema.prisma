generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id            String       @id @default(cuid())
  titleEn       String
  titleAr       String
  slug          String       @unique
  descriptionEn String
  descriptionAr String
  priceUSD      Decimal      @db.Decimal(10, 2)
  coverImageUrl String
  r2FileKey     String
  isFeatured    Boolean      @default(false)
  isNewRelease  Boolean      @default(true)
  categoryId    String
  authorId      String?
  createdAt     DateTime     @default(now())
  sellerId      String?
  status        BookStatus   @default(PENDING_REVIEW)
  updatedAt     DateTime     @default(now()) @updatedAt
  // Optional per-book royalty rate override (percent, e.g. 65.00 =
  // 65%). Nullable: most books use the author's own override rate, or
  // failing that the institution-wide default — see
  // lib/royalty.js:resolveRoyaltyRate() for the exact resolution
  // order. Never a second, disconnected "rate" the admin has to keep
  // in sync by hand.
  royaltyRatePct Decimal?    @db.Decimal(5, 2)
  author        User?        @relation("BookAuthor", fields: [authorId], references: [id])
  category      Category     @relation(fields: [categoryId], references: [id])
  seller        User?        @relation("BookSeller", fields: [sellerId], references: [id])
  bookAccess    BookAccess[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  royaltyLedgerEntries RoyaltyLedgerEntry[]
  courseReadings CourseReading[]

  @@index([authorId])
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  totalUSD        Decimal         @db.Decimal(10, 2)
  paidAmount      Decimal         @db.Decimal(10, 2)
  currencyCode    String
  exchangeRate    Decimal         @db.Decimal(12, 6)
  status          OrderStatus     @default(ORDER_PLACED)
  paymentMethod   PaymentMethod
  paymentRef      String?         @unique
  paymentProofUrl String?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvedAt      DateTime?
  paidAt          DateTime?
  paymentGateway  PaymentGateway?
  paymentStatus   PaymentStatus   @default(PENDING)
  rejectedAt      DateTime?
  bookAccess      BookAccess[]
  downloads       DownloadLog[]
  user            User            @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  receipt         Receipt?
  royaltyLedgerEntries RoyaltyLedgerEntry[]
  refundRequests  RefundRequest[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentGateway])
  @@index([createdAt])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  gateway           PaymentGateway
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  amount            Decimal        @db.Decimal(10, 2)
  currencyCode      String
  exchangeRate      Decimal        @db.Decimal(12, 6)
  gatewayReference  String?
  checkoutReference String?
  transactionId     String?
  authorizationUrl  String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gateway])
  @@index([status])
  @@index([gatewayReference])
  @@index([transactionId])
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// Model 32 §4 -- Finance work-queue item. A refund is never applied to
// an Order/Payment automatically; this only records that a refund was
// requested and, once a Finance staff member with FINANCE_FEES edit
// access decides it, what the outcome was. The actual money movement
// (reversing a Stripe/Paystack charge) stays a real-world action taken
// outside this record -- PROCESSED means Finance confirms it was done.
model RefundRequest {
  id              String               @id @default(cuid())
  orderId         String
  requestedById   String
  amountUSD       Decimal              @db.Decimal(10, 2)
  reason          String               @db.Text
  status          RefundRequestStatus  @default(PENDING)
  resolutionNote  String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("RefundRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedBy  StaffProfile? @relation("RefundRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([requestedById])
  @@index([status])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  bookId   String
  priceUSD Decimal @db.Decimal(10, 2)
  quantity Int     @default(1)
  book     Book    @relation(fields: [bookId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  royaltyLedgerEntry RoyaltyLedgerEntry?

  @@index([orderId])
  @@index([bookId])
}

model BookAccess {
  id         String    @id @default(cuid())
  userId     String
  bookId     String
  orderId    String
  approvedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, orderId])
  @@index([userId])
  @@index([bookId])
  @@index([orderId])
}

model Cart {
  id        String     @id
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id       String @id
  cartId   String
  bookId   String
  quantity Int    @default(1)
  book     Book   @relation(fields: [bookId], references: [id])
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([cartId])
  @@index([bookId])
}

model Category {
  id       String    @id
  nameEn   String
  nameAr   String
  slug     String    @unique
  books    Book[]
  courses  Course[]
  programs Program[]
}

// The public /bookstore page's own surrounding copy (Model 27) --
// hero text, section labels/headings, the publisher CTA and the
// footer About blurb. Singleton row, same pattern as
// HomepageSectionsText. The book catalogue itself (Book, Category,
// BookOrder, ...) was already admin-editable before this model.
model BookstorePageContent {
  id                String   @id @default(cuid())
  heroEyebrow       String
  heroTitle         String
  heroSubtitle      String   @db.Text
  // The 3 short "✓ ..." trust-checklist phrases under the hero search bar.
  heroTrust         String[] @default([])
  categoryLabel     String
  categoryHeading   String
  featuredLabel     String
  featuredHeading   String
  featuredSubtitle  String
  collectionLabel   String
  collectionHeading String
  publisherLabel    String
  publisherHeading  String
  publisherText     String   @db.Text
  footerAboutText   String   @db.Text
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// The "why shop with us" value-strip cards on /bookstore (Model
// 27) -- same shape/pattern as HomepageFeatureCard.
model BookstoreValueCard {
  id        String   @id @default(cuid())
  icon      String
  title     String
  text      String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Alumni (Model 29) -- public /alumni page. Page copy is a
// singleton like BookstorePageContent/HomepageSectionsText.
// Statistics and Spotlight are separate ordered lists an admin
// fills in with real figures and real graduate stories -- both
// start empty and the public page simply doesn't render a section
// until content exists, the same pattern as HomepageHeroBanner.
// Deliberately independent of StudentProfile/GraduationApplication:
// those are internal student records, not something to publish
// as public alumni profiles without the graduate's consent.
model AlumniPageContent {
  id                String   @id @default(cuid())
  heroEyebrow       String
  heroTitle         String
  heroSubtitle      String   @db.Text
  statsHeading      String
  spotlightLabel    String
  spotlightHeading  String
  spotlightSubtitle String   @db.Text
  ctaHeading        String
  ctaText           String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AlumniStat {
  id        String   @id @default(cuid())
  value     String
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model AlumniProfile {
  id             String   @id @default(cuid())
  name           String
  graduationYear String?
  program        String?
  photoUrl       String?
  currentRole    String?
  quote          String?  @db.Text
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

model Country {
  id             String        @id
  code           String        @unique
  name           String
  currencyCode   String
  currencySymbol String
  exchangeRate   ExchangeRate?
  users          User[]
}

model ExchangeRate {
  id           String   @id
  currencyCode String   @unique
  rateToUSD    Decimal  @db.Decimal(12, 6)
  updatedAt    DateTime
  countryId    String   @unique
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
}

model Course {
  id            String   @id
  titleEn       String
  titleAr       String
  slug          String   @unique
  courseCode    String   @unique
  descriptionEn String
  descriptionAr String
  creditHours   Int      @default(3)
  isPaid        Boolean  @default(false)
  priceUSD      Decimal  @default(0.00) @db.Decimal(10, 2)
  thumbnailUrl  String
  isPublished   Boolean  @default(false)
  categoryId    String
  programId     String?
  createdAt     DateTime @default(now())

  // Course approval workflow (Model 11) — Academic Governance already
  // named this gap twice: a course had isPublished only, no distinct
  // "approved" state a Head of Department could actually set. Defaults
  // to APPROVED so the Academy's existing, already-taught courses are
  // not silently unapproved by this migration; a course created going
  // forward through the Programme Coordinator's own creation API starts
  // at DRAFT instead (see app/api/coordinator/courses/route.js).
  approvalStatus ApprovalStatus @default(APPROVED)
  approvalNote   String?

  // The course's real, approved primary learning outcome and
  // assessment type, exactly as stated in the academy-course-
  // catalogue governance document (Model 15) -- not a new academic
  // decision, just giving already-approved text a queryable home.
  outcomeEn      String?
  assessmentType String?

  // Model 19 -- whether this course has an approved practical
  // assessment component (e.g. Qur'an recitation, Tajweed
  // performance, a teaching demonstration), and that component's
  // approved pass requirement stated as text -- never a number this
  // document would otherwise have to invent. Both left unset by
  // default: a course has no practical component until Academic
  // Records/the Programme Coordinator explicitly says it does.
  practicalRequired        Boolean @default(false)
  practicalPassRequirement String?

  // Curriculum sequencing for real automatic course assignment — which
  // programme year/semester this course belongs to. Named distinctly
  // from the unrelated "level" label already used elsewhere (a
  // programme's degree level, e.g. "Bachelor's") to avoid any
  // collision. Nullable: existing courses have no value until Academic
  // Records sets one, and the auto-assignment engine simply skips
  // courses with no semesterLevel set rather than guessing.
  semesterLevel Int?

  category    Category           @relation(fields: [categoryId], references: [id])
  program     Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  sections    CourseSection[]
  enrollments Enrollment[]
  instructors InstructorCourse[]
  grades      Grade[]
  exams       Exam[]

  // Self-referencing prerequisite graph (implicit many-to-many): a course
  // can require any number of other courses to be completed-and-passed
  // first. Empty by default for every existing course.
  prerequisites     Course[] @relation("CoursePrerequisites")
  isPrerequisiteFor Course[] @relation("CoursePrerequisites")

  attendanceRecords Attendance[]
  assignments       Assignment[]
  quizzes           Quiz[]
  tutoringRequests  TutoringRequest[]
  absenceExcuses    AbsenceExcuse[]
  qualityReviews    QualityReview[]
  courseRequests    Request[]
  discussions       Discussion[]
  liveClasses       LiveClass[]
  evaluations       CourseEvaluation[]
  integrityCases    IntegrityCase[]
  readings          CourseReading[]
  learningOutcomes  CourseLearningOutcome[]

  @@index([categoryId])
  @@index([programId])
}

enum CourseReadingType {
  REQUIRED
  RECOMMENDED
}

// Model 28: links a Course's syllabus directly to an authoritative
// LibraryResource, Book, or InstituteLibraryResource row for required
// textbooks / recommended readings, instead of duplicating a file
// across multiple rows. Exactly one of libraryResourceId / bookId /
// instituteLibraryResourceId is set per row -- never more than one,
// and never a fourth, disconnected reading-list table.
//
// instituteLibraryResourceId (added alongside the institute Digital
// Library -- see InstituteLibraryResource below) is a deliberate,
// separate integration: an authorized academic user may link an
// approved institute Digital Library resource to a course, exactly as
// they already can with the owner's personal LibraryResource or a
// Bookstore Book. This is additive, not a merge of the systems --
// linking a resource to a course never grants the institute Library
// ownership over the Bookstore or the personal Library, and vice
// versa. Unlike the personal libraryResourceId/bookId branches (which
// carry no further access check once linked), a linked institute
// resource still enforces its own visibility tier for the requesting
// student at read time -- see
// app/api/student/courses/[id]/readings/route.js.
model CourseReading {
  id                        String            @id @default(cuid())
  courseId                  String
  libraryResourceId         String?
  bookId                    String?
  instituteLibraryResourceId String?
  readingType               CourseReadingType @default(REQUIRED)
  note                      String?
  order                     Int               @default(0)
  createdAt                 DateTime          @default(now())

  course                  Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  libraryResource         LibraryResource?         @relation(fields: [libraryResourceId], references: [id], onDelete: Cascade)
  book                    Book?                    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  instituteLibraryResource InstituteLibraryResource? @relation(fields: [instituteLibraryResourceId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([libraryResourceId])
  @@index([bookId])
  @@index([instituteLibraryResourceId])
}

model CourseProgress {
  id          String   @id
  userId      String
  lectureId   String
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())
  lecture     Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId])
  @@index([userId])
  @@index([lectureId])
}

model CourseSection {
  id       String    @id
  titleEn  String
  titleAr  String
  order    Int
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@index([courseId])
}

model Lecture {
  id            String           @id
  titleEn       String
  titleAr       String
  mediaType     MediaType        @default(VIDEO)
  mediaUrl      String
  durationSec   Int              @default(0)
  isFreePreview Boolean          @default(false)
  order         Int
  sectionId     String
  progress      CourseProgress[]
  section       CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model DownloadLog {
  id           String   @id
  userId       String
  orderId      String
  bookId       String
  downloadedAt DateTime @default(now())
  ipAddress    String
  order        Order    @relation(fields: [orderId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([bookId])
}

enum MediaCategory {
  SCHOLARLY_TALKS
  VIDEO_LESSONS
  AUDIO_RECORDINGS
  KHUTBAH
  POEMS
  MUTOON
  LECTURES
}

enum LibraryCategory {
  ARTICLES
  FATWAS
  RESEARCH_PAPERS
  HISTORICAL_MATERIALS
  MANUSCRIPTS
  EDUCATIONAL_RESOURCES
  CLASSICAL_TEXTS
}

enum MediaSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model MediaItem {
  id                   String        @id @default(cuid())
  titleEn              String
  titleAr              String
  slug                 String        @unique
  descriptionEn        String
  descriptionAr        String
  category             MediaCategory
  mediaType            MediaType     @default(VIDEO)
  mediaUrl             String
  thumbnailUrl         String?
  speaker              String?
  durationSec          Int           @default(0)
  isPublished          Boolean       @default(true)
  isFreePreview        Boolean       @default(false)
  requiresSubscription Boolean       @default(true)
  priceUSD             Decimal?      @db.Decimal(10, 2)
  uploadedById         String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublished])
  @@index([uploadedById])
}

// Written/reference content shown on the public "Library" page —
// articles, fatwas, research papers, manuscripts, etc. Deliberately
// separate from MediaItem: no subscription gate, no media-player
// fields (duration, mediaType). Access is controlled only by
// isPublished, per the Library's own independent (non-subscription)
// access rules.
//
// Named LibraryResource (not LibraryItem) to avoid colliding with the
// pre-existing LibraryItem model below, which is an unrelated physical
// book lending/loan catalogue run by the Librarian role — same English
// word, two different features. See CLAUDE.md.
model LibraryResource {
  id            String          @id @default(cuid())
  titleEn       String
  titleAr       String
  slug          String          @unique
  descriptionEn String
  descriptionAr String
  category      LibraryCategory
  // Admin-entered, may point at an external/already-public URL (see
  // lib/r2FileLifecycle.ts's own comment on this field).
  fileUrl       String
  thumbnailUrl  String?
  author        String?
  isPublished   Boolean         @default(true)
  uploadedById  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  courseReadings CourseReading[]

  @@index([category])
  @@index([isPublished])
  @@index([uploadedById])
}

// =====================================================================
// INSTITUTE DIGITAL LIBRARY (spec §12) -- a Delegated Operation owned
// by the Librarian / Library Services role, run through the same
// LIBRARY_OPS module already used for the physical circulation system
// below (LibraryItem/LibraryLoan/LibraryReservation). Deliberately a
// THIRD, distinct model from both:
//   - LibraryResource (Personal Management) -- the platform owner's
//     own personal public reading library, isPublished-only, no
//     viewer-tiering. See that model's own comment.
//   - LibraryItem (Delegated Operations) -- the physical book
//     lending/loan catalogue (title/author/ISBN/copies/loans), run by
//     the same Librarian role but a completely different kind of
//     content (physical circulation, not digital reading content).
// InstituteLibraryResource is the institute's own DIGITAL content --
// e-books, articles, fatwas, research papers, manuscripts, mutoon/
// texts, academic resources, course resources -- created and
// published by institute Library staff, never by the platform owner
// personally and never overlapping with the physical catalogue.
// =====================================================================

enum InstituteLibraryCategory {
  DIGITAL_BOOKS
  EBOOKS
  ARTICLES
  FATWAS
  RESEARCH_PAPERS
  MANUSCRIPTS
  MUTOON_TEXTS
  ACADEMIC_RESOURCES
  ISLAMIC_SCHOLARLY_RESOURCES
  COURSE_RESOURCES
}

// Institute Digital Library visibility tiers. A distinct enum from
// LibraryResourceVisibility on purpose (there is in fact no such enum
// any more -- an earlier build mistakenly added viewer-tiering to the
// PERSONAL LibraryResource model; that was reverted, and this enum is
// the correct home for the same well-designed rank system). See
// lib/institute-library-visibility.js for the single enforcement
// helper and full rank documentation.
//   0 PUBLIC              -- anyone, including anonymous visitors
//   1 INSTITUTE_ONLY      -- any signed-in institute account
//   2 STUDENTS_AND_STAFF  -- enrolled students and staff
//   3 FACULTY_STAFF_ONLY  -- faculty/instructional staff and above
//   4 RESTRICTED          -- Admin/SUPER_ADMIN or a LIBRARY_OPS holder
enum InstituteLibraryVisibility {
  INSTITUTE_ONLY
  STUDENTS_AND_STAFF
  FACULTY_STAFF_ONLY
  PUBLIC
  RESTRICTED
}

// Institute Digital Library resource-status workflow. Kept as its own
// field distinct from isPublished/visibility: the spec's "resource
// status" wording implies an editorial workflow (a resource is
// drafted, then reviewed, then published), which is a different axis
// from WHO may see it once published (visibility) or WHETHER it is
// visible at all (isPublished as the coarse kill-switch). A resource
// can sit in UNDER_REVIEW while isPublished stays false; PUBLISHED is
// the only status a Librarian would pair with isPublished = true.
enum InstituteLibraryResourceStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

// Named InstituteLibraryResource -- distinctly "Institute"-prefixed so
// it can never be confused with either LibraryResource (personal) or
// LibraryItem (physical circulation). Owned end-to-end by the
// Librarian / Library Services delegated role via the LIBRARY_OPS
// module; Admin/SUPER_ADMIN retain read-only oversight only (see
// app/admin/library/page.tsx), never operational control.
model InstituteLibraryResource {
  id            String                         @id @default(cuid())
  titleEn       String
  titleAr       String
  descriptionEn String
  descriptionAr String
  slug          String                         @unique
  category      InstituteLibraryCategory
  status        InstituteLibraryResourceStatus @default(DRAFT)

  // Two distinct fields rather than one flexible URL: fileUrl is for
  // an app-hosted/uploaded document (e.g. an R2-stored PDF the
  // Librarian uploads directly), externalUrl is for the spec's
  // explicitly-called-out "external resource links" (e.g. a link to
  // a resource hosted elsewhere). Both optional since a resource may
  // have only one, but at least one must be present -- enforced at
  // the route layer, not the schema layer, matching how this
  // codebase validates "at least one of" conditions elsewhere.
  fileUrl     String?
  externalUrl String?

  thumbnailUrl String?
  author       String?
  subject      String?
  topic        String?

  // Coarse kill-switch, same semantics as LibraryResource.isPublished
  // -- but defaults to FALSE here (unlike the personal library's
  // @default(true)): this is institute content, so it must be
  // deliberately published from day one. There are zero existing rows
  // for this brand-new model, so there is no legacy-data concern the
  // way there was for the original (now-reverted) migration onto
  // LibraryResource.
  isPublished Boolean @default(false)

  // Fine-grained visibility tier, layered UNDER isPublished: a viewer
  // must satisfy isPublished === true AND their access tier must
  // cover this value (see lib/institute-library-visibility.js).
  // Defaults to INSTITUTE_ONLY, never PUBLIC -- a resource only
  // becomes Public when an authorized Library staff member explicitly
  // re-tiers it there (logged in the Audit Log).
  visibility InstituteLibraryVisibility @default(INSTITUTE_ONLY)

  // Institute departmental content created by institute staff, not
  // the platform owner personally -- references StaffProfile, not
  // User (contrast with LibraryResource.uploadedById -> User).
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy     StaffProfile?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  courseReadings CourseReading[]

  @@index([category])
  @@index([status])
  @@index([isPublished])
  @@index([visibility])
  @@index([uploadedById])
}

model MediaSubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  descriptionEn String?
  priceUSD      Decimal  @db.Decimal(10, 2)
  durationDays  Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions UserMediaSubscription[]
}

model UserMediaSubscription {
  id             String                  @id @default(cuid())
  userId         String
  planId         String
  status         MediaSubscriptionStatus @default(PENDING)
  startedAt      DateTime                @default(now())
  expiresAt      DateTime
  paymentGateway PaymentGateway?
  paymentRef     String?                 @unique
  paidAmount     Decimal?                @db.Decimal(10, 2)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MediaSubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model Enrollment {
  id        String       @id
  userId    String
  courseId  String
  status    AccessStatus @default(PENDING)
  createdAt DateTime     @default(now())
  course    Course       @relation(fields: [courseId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
  @@index([courseId])
}

// Model 21 -- the instructor's role on this specific assignment, and
// whether the assignment itself is still current. Both additive and
// defaulted so every existing row (recorded before either existed)
// keeps working exactly as it did today: role LEAD matches the "one
// instructor per course" case this app has only ever had, and status
// ACTIVE matches every existing row's real state. WITHDRAWN lets a
// Head of Department end an assignment (e.g. mid-term) without
// destroying the historical teaching record the way a hard delete
// would -- the existing DELETE endpoint stays available too, for
// correcting an assignment made in error rather than ending a real one.
enum InstructorCourseRole {
  LEAD
  CO_INSTRUCTOR
  TEACHING_ASSISTANT
}

enum InstructorCourseStatus {
  ACTIVE
  WITHDRAWN
}

model InstructorCourse {
  id           String   @id @default(cuid())
  instructorId String
  courseId     String
  createdAt    DateTime @default(now())

  // Model 21 -- which academic period this assignment is for. Nullable
  // so pre-existing assignments (recorded before this field existed)
  // keep working unchanged; a Head of Department picks the term when
  // making a new assignment, the same way instructors already pick a
  // term for exams and grades (Exam.termId, Grade.termId).
  termId String?
  role   InstructorCourseRole   @default(LEAD)
  status InstructorCourseStatus @default(ACTIVE)

  instructor User          @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term       AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([instructorId, courseId])
  @@index([instructorId])
  @@index([courseId])
  @@index([termId])
}

// Section Discussion — a professional, per-course group discussion space.
// "Section" here is a course's real cohort: everyone with an Enrollment
// in that course, plus the instructor(s) assigned to it via
// InstructorCourse. No separate administrative "Section" entity exists
// in this data model (no course is actually split into multiple
// sections), so scoping to the course itself is the honest real
// boundary rather than an invented one — a student in a different
// course never sees this course's discussions or submissions.
//
// isExercise marks a discussion posted by an instructor as a real
// activity with a deadline and (optionally) supporting files, rather
// than an open-ended discussion thread; only an instructor assigned to
// the course can create one (enforced in the API, not just the UI).
model Discussion {
  id            String    @id @default(cuid())
  courseId      String
  authorId      String
  title         String
  body          String
  isExercise    Boolean   @default(false)
  deadline      DateTime?
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    DiscussionComment[]
  submissions ExerciseSubmission[]

  @@index([courseId])
  @@index([authorId])
}

model DiscussionComment {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([authorId])
}

// A student's answer to an exercise discussion — visible to every
// student in the same course (peer/group-learning visibility, as
// requested), not just to the instructor. One submission per student
// per exercise; resubmitting before the deadline replaces it rather
// than creating a duplicate.
model ExerciseSubmission {
  id           String   @id @default(cuid())
  discussionId String
  studentId    String
  answerText   String?
  fileUrl      String?
  feedback     String?
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([discussionId, studentId])
  @@index([discussionId])
  @@index([studentId])
}

model Grade {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  // Which academic term this grade was earned in. Nullable so existing
  // grade rows (recorded before this field existed) keep working — the
  // UI shows "Term not recorded" for those, real data for everything
  // else. Instructors pick the term when entering new grades, the same
  // way they already do for exams (see Exam.termId).
  termId     String?
  quiz1      Float?
  quiz2      Float?
  assignment Float?
  midterm    Float?
  final      Float?
  // Model 19 -- the practical-assessment mark, only meaningful for a
  // course with Course.practicalRequired = true. Recorded and shown
  // on its own; deliberately not part of any calculated-total
  // formula (see app/instructor-dashboard/grades/page.tsx) since no
  // approved policy yet states how it should combine with the
  // knowledge-assessment components.
  practical  Float?
  // Grade finalization -- closes the gap where an instructor could
  // silently overwrite an already-recorded grade forever. DRAFT rows
  // may still be freely upserted by the instructor
  // (app/api/instructor/portal/grades/route.js); once an instructor
  // finalizes a row (their own "Finalize" action), it becomes
  // FINALIZED and locked -- the only way to change it after that is
  // the Registrar's controlled GradeCorrection workflow below
  // (app/api/records/grade-corrections/route.ts). Defaults every
  // existing and newly-created row to DRAFT so no legacy data is
  // silently finalized.
  status            GradeStatus @default(DRAFT)
  finalizedAt       DateTime?
  finalizedByUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term    AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  corrections GradeCorrection[]

  // One row per attempt: a repeated course gets a second row (a new
  // termId) instead of overwriting the first attempt's grade. Prior
  // legacy rows saved before a term was required keep termId = null
  // and are left exactly as they are.
  @@unique([studentId, courseId, termId])
  @@index([studentId])
  @@index([courseId])
  @@index([termId])
  @@index([status])
}

// Whether a Grade row is still open for the instructor to edit (DRAFT)
// or has been locked in by the instructor's own "Finalize" action
// (FINALIZED) and can now only change via the Registrar's controlled
// GradeCorrection workflow.
enum GradeStatus {
  DRAFT
  FINALIZED
}

// Model 19 Section 27 -- a controlled audit trail for a change to an
// ALREADY-RECORDED Grade, kept separate from an instructor's
// ordinary first-time entry (which stays exactly as it was). Written
// only by the dedicated correction endpoint
// (app/api/records/grade-corrections/route.ts), gated on Academic
// Records edit access -- an instructor's own save can never silently
// overwrite an official result without this record existing.
model GradeCorrection {
  id               String   @id @default(cuid())
  gradeId          String
  fieldChanged     String
  originalValue    Float?
  correctedValue   Float?
  reason           String   @db.Text
  correctedByStaffId String
  correctedByName    String
  correctedAt        DateTime @default(now())

  grade Grade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId])
}

model ManuscriptRevision {
  id           String               @id
  submissionId String
  fileUrl      String
  notes        String?
  createdAt    DateTime             @default(now())
  submission   ManuscriptSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ManuscriptSubmission {
  id             String               @id
  authorId       String
  title          String
  genre          String
  description    String
  manuscriptUrl  String
  services       String[]
  status         SubmissionStatus     @default(SUBMITTED)
  quoteAmount    Float?
  quoteDetails   String?
  assignedEditor String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  revisions      ManuscriptRevision[]
  author         User                 @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
}

model NewsletterCampaign {
  id       String   @id
  subject  String
  content  String
  category String
  sentAt   DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

// type is nullable and defaults to unset -- every existing call site
// (admin dashboard, publishing, bookstore uploads) keeps creating
// plain notifications exactly as before. Community likes/mentions/
// comments are the first caller to set it, so they can be filtered
// into their own inbox view instead of mixing into the same stream
// as registration/academic alerts (Model 25 §13) without inventing a
// second Notification table.
enum NotificationType {
  COMMUNITY
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model Receipt {
  id        String   @id
  receiptNo String   @unique
  orderId   String   @unique
  pdfUrl    String
  issuedAt  DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AdmissionFeeSettings {
  id                  String   @id @default(cuid())
  juniorGhana         Decimal  @db.Decimal(10, 2)
  seniorGhana         Decimal  @db.Decimal(10, 2)
  matureGhana         Decimal  @db.Decimal(10, 2)
  juniorInternational Decimal  @db.Decimal(10, 2)
  seniorInternational Decimal  @db.Decimal(10, 2)
  matureInternational Decimal  @db.Decimal(10, 2)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model AdmissionApplication {
  id                    String                 @id @default(cuid())
  applicationNumber     String                 @unique
  email                 String
  passwordHash          String?
  fullName              String
  preferredName         String?
  dateOfBirth           DateTime
  gender                String
  nationality           String
  countryOfResidence    String
  phoneNumber           String
  idNumber              String
  residentialAddress    String
  applicantCategory     String
  guardianName          String
  guardianPhone         String
  guardianRelationship  String
  emergencyName         String
  emergencyPhone        String
  emergencyRelationship String
  highestEducation      String
  institutionName       String
  programId             String?
  programLevel          String?
  programName           String?
  // Which of the Academy's five pathways (Academy Pathways §1) the
  // applicant believes fits them — a starting point for Placement
  // (§8 of that document), never a substitute for it: the actual
  // pathway a learner enters is decided by the placement assessment
  // below, not by this preference alone.
  pathwayPreference     String?
  preferredDepartmentId String?
  specialization        String?
  studyMode             StudyMode?
  admissionType         AdmissionType          @default(PROGRAM)
  studySession          String

  // Academic background and placement self-assessment, collected at
  // application time. These are the applicant's own account, used as
  // a starting point for the actual Placement workflow (Academy
  // Pathways §8) — never treated as the placement result itself; see
  // the PlacementAssessment model below for the assessed outcome.
  islamicStudiesBackground String?         @db.Text
  quranReadingSelf         SelfRatedLevel?
  quranTajweedSelf         SelfRatedLevel?
  quranHifzSelf            SelfRatedLevel?
  quranRecitationSelf      SelfRatedLevel?
  arabicReadingSelf        SelfRatedLevel?
  arabicWritingSelf        SelfRatedLevel?
  arabicGrammarSelf        SelfRatedLevel?
  arabicVocabularySelf     SelfRatedLevel?
  arabicConversationSelf   SelfRatedLevel?
  quranicArabicSelf        SelfRatedLevel?
  learningGoals            String?         @db.Text
  supportNeeds             String?         @db.Text
  declarationAccepted      Boolean         @default(false)
  declarationAcceptedAt    DateTime?

  identityDocType       String
  identityDocumentUrl   String?
  passportPictureUrl    String?
  transcriptsUrl        String?
  certificateUrl        String?
  testimonialUrl        String?
  recommendationUrl     String?
  admissionFee          Decimal                @db.Decimal(10, 2)
  currencyCode          String
  feeBasis              String
  status                StudentAdmissionStatus @default(PENDING_PAYMENT)
  declineReason         String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  paidAt                DateTime?
  payment               AdmissionPayment?
  notes                 AdmissionNote[]
  auditLogs             AdmissionAuditLog[]
  admissionLetter       AdmissionLetter?
  program               Program?               @relation(fields: [programId], references: [id], onDelete: Restrict)
  preferredDepartment   Department?            @relation(fields: [preferredDepartmentId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([countryOfResidence])
  @@index([programId])
  @@index([preferredDepartmentId])
}

model AdmissionPayment {
  id                String               @id @default(cuid())
  applicationId     String               @unique
  gateway           PaymentGateway
  method            PaymentMethod
  status            PaymentStatus        @default(PENDING)
  amount            Decimal              @db.Decimal(10, 2)
  currencyCode      String
  gatewayReference  String?
  checkoutReference String?
  transactionId     String?
  authorizationUrl  String?
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([gateway])
  @@index([status])
  @@index([gatewayReference])
  @@index([transactionId])
}

// A one-off or recurring gift from a visitor, made through the public
// /donate page. Unlike AdmissionApplication/AdmissionPayment, there is
// no separate "parent" record to split from -- a donation has no
// application, account, or approval step behind it, so donor details
// and payment/gateway fields live together on one row, matching how
// the public form actually collects them in a single step. Donor
// identity is optional (donorName nullable, donorEmail used only to
// send a receipt / for the donor's own reference, never required to
// give). Reuses the same PaymentGateway/PaymentStatus/PaymentMethod
// enums as AdmissionPayment/Payment rather than inventing new ones.
model Donation {
  id                String         @id @default(cuid())
  donorName         String?
  donorEmail        String?
  isRecurring       Boolean        @default(false)
  purpose           String
  amount            Decimal        @db.Decimal(10, 2)
  currencyCode      String
  gateway           PaymentGateway
  method            PaymentMethod?
  status            PaymentStatus  @default(PENDING)
  gatewayReference  String?
  checkoutReference String?
  transactionId     String?
  authorizationUrl  String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([gateway])
  @@index([status])
  @@index([gatewayReference])
  @@index([transactionId])
  @@index([createdAt])
}

enum NoteVisibility {
  // Staff-only. Never returned by any applicant-facing route.
  INTERNAL
  // Shown to the applicant on their tracking page.
  APPLICANT_VISIBLE
}

model AdmissionNote {
  id            String         @id @default(cuid())
  applicationId String
  visibility    NoteVisibility @default(INTERNAL)
  note          String         @db.Text
  authorStaffId String?
  authorName    String
  createdAt     DateTime       @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([visibility])
}

// Every admission status transition and decision gets a row here --
// who did it, when, and the before/after status. This is what Model
// 16's "full audit trail for admission decisions" requirement is
// built on; nothing like it existed before.
model AdmissionAuditLog {
  id            String   @id @default(cuid())
  applicationId String
  action        String
  fromStatus    String?
  toStatus      String?
  actorUserId   String?
  actorName     String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}

// Model 17 (Registry, Admission Decisions & Admission Documents).
// The Letter of Admission workflow: Generate (DRAFT, editable) ->
// Review -> Finalize (locked, official PDF). A correction after
// finalization reopens the letter (status back to DRAFT, version
// incremented) rather than silently overwriting the issued document
// -- the prior version is preserved in `previousVersions` for
// traceability. One letter per application; the applicant only ever
// sees the current FINALIZED pdfUrl (via /api/admissions/track/letter
// and the student portal), never a DRAFT.
enum AdmissionLetterStatus {
  DRAFT
  FINALIZED
}

model AdmissionLetter {
  id                 String                @id @default(cuid())
  applicationId      String                @unique
  status             AdmissionLetterStatus @default(DRAFT)
  version            Int                   @default(1)
  programmeText      String?
  departmentText     String?
  qualificationText  String?
  intakeSession      String?
  admissionDate      DateTime?
  conditions         String?               @db.Text
  signatoryName      String?
  signatoryTitle     String?
  pdfUrl             String?
  previousVersions   Json?
  generatedByStaffId String?
  generatedByName    String?
  finalizedByStaffId String?
  finalizedByName    String?
  finalizedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
}

model User {
  id                String       @id
  name              String
  email             String       @unique
  emailVerified     DateTime?
  passwordHash      String
  avatarUrl         String?
  role              Role         @default(USER)
  authorStatus      AuthorStatus @default(PENDING)
  preferredLanguage Language     @default(EN)
  countryId         String?
  // Optional contact/profile fields collected at signup (bookstore /
  // media accounts) so an account holds enough to actually reach or
  // identify the person behind it -- both nullable so every existing
  // account (created before this field existed) stays valid with no
  // backfill required. countryName is a plain free-text label (same
  // pattern the admission form already uses for its own country
  // picker), kept deliberately separate from the countryId relation
  // above, which is real seeded reference data used for currency /
  // exchange-rate purposes and must not be guessed into by a signup
  // form.
  phone             String?
  countryName       String?
  // Security audit fix -- bumped on password change or an explicit
  // "log out of all devices" action. Every signed session token embeds
  // the tokenVersion that was current when it was issued, so bumping
  // this instantly invalidates every previously-issued token for this
  // user without needing a server-side session table.
  tokenVersion      Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  authorAdmission AuthorAdmission?
  staffProfile    StaffProfile?
  studentProfile  StudentProfile?

  books              Book[]                  @relation("BookAuthor")
  soldBooks          Book[]                  @relation("BookSeller")
  bookAccess         BookAccess[]
  cart               Cart?
  courseProgress     CourseProgress[]
  downloads          DownloadLog[]
  enrollments        Enrollment[]
  manuscripts        ManuscriptSubmission[]
  notifications      Notification[]
  orders             Order[]
  mediaItems         MediaItem[]
  libraryResources   LibraryResource[]
  mediaSubscriptions UserMediaSubscription[]

  country Country? @relation(fields: [countryId], references: [id])

  instructorCourses InstructorCourse[]
  liveClasses       LiveClass[]
  grades            Grade[]
  announcements     Announcement[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  ictTickets        ICTTicket[]
  sponsors          Sponsor[]

  discussionsAuthored Discussion[]
  discussionComments  DiscussionComment[]
  exerciseSubmissions ExerciseSubmission[]
  academicCalendars   AcademicCalendar[]

  // Ulul Azm Community (student-wide, cross-course -- distinct from the
  // course-scoped Discussion/DiscussionComment above).
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityProfile  CommunityProfile?
  communityBlocksMade     CommunityBlock[]  @relation("CommunityBlocksMade")
  communityBlocksReceived CommunityBlock[]  @relation("CommunityBlocksReceived")
  communityReportsMade     CommunityReport[] @relation("CommunityReportsMade")
  communityReportsReviewed CommunityReport[] @relation("CommunityReportsReviewed")
  communityGuidelinesAcceptance CommunityGuidelinesAcceptance?
  auditLogEntries AuditLog[] @relation("AuditLogActor")
  eventsCreated   Event[]    @relation("EventCreatedBy")
  newsCreated     NewsArticle[] @relation("NewsCreatedBy")

  // Author Royalty & Payout system — an author's own optional rate
  // override, their real per-sale ledger, and their payout history.
  royaltyOverride       AuthorRoyaltyOverride?
  royaltyLedgerEntries  RoyaltyLedgerEntry[]     @relation("AuthorRoyaltyLedger")
  royaltyPayouts        AuthorPayout[]           @relation("AuthorPayouts")
  refundRequests        RefundRequest[]          @relation("RefundRequestRequestedBy")

  @@index([countryId])
  @@index([role])
}

model AuthorAdmission {
  id                 String          @id @default(cuid())
  userId             String          @unique
  status             AdmissionStatus @default(PENDING)
  // Set once at application time from AuthorFeeSettings + the
  // applicant's stated country of residence, then charged verbatim
  // during Paystack initialize — mirrors AdmissionApplication's own
  // admissionFee/currencyCode/feeBasis fields.
  countryOfResidence String?
  applicationFee     Decimal?        @db.Decimal(10, 2)
  currencyCode       String?
  feeBasis           String?
  // Set at application time from AuthorFeeSettings.validityDays (when
  // configured) — an unpaid application past this date is treated as
  // expired and must be resubmitted rather than paid for.
  feeExpiresAt       DateTime?
  // Real author profile + standing payout preference, set by the
  // author themselves from the Author Portal (Author Profile /
  // Payment & Settings). All nullable — an author who hasn't set
  // these yet simply has none, never a fabricated placeholder.
  bio                    String?
  specialty              String?
  payoutMethodPreference AuthorPayoutMethodPreference?
  // Bank transfer destination (free text — no hardcoded bank list).
  // NOTE: stored as plain, unencrypted-at-rest text (no existing
  // encrypted-at-rest precedent for an account-number-shaped field
  // elsewhere in this schema). Treat as sensitive author-supplied
  // banking information: expose only to staff who need it, never in
  // a general/public API response.
  bankName               String?
  bankAccountNumber      String?
  // Mobile money destination (provider is free text — no hardcoded
  // network list, same reasoning as bankName above).
  momoProvider           String?
  momoNumber             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment            AuthorPayment?
}

model AuthorPayment {
  id                String          @id @default(cuid())
  admissionId       String          @unique
  gateway           PaymentGateway
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currencyCode      String
  exchangeRate      Decimal         @db.Decimal(12, 6)
  gatewayReference  String?
  checkoutReference String?
  checkoutUrl       String?
  // Paystack's own transaction id, distinct from gatewayReference
  // (our reference) — recorded on verification for auditing, same
  // as AdmissionPayment.transactionId.
  transactionId     String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  admission         AuthorAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([gateway])
  @@index([status])
  @@index([gatewayReference])
}

// Institution-wide Author Application Fee configuration — a
// singleton row (id: "default-author-fees") the Super Admin manages
// from Admin > Author Application Fee. Deliberately separate from
// AdmissionFeeSettings (student admissions): authors pay one fee per
// residency tier, not the student age-tier structure.
model AuthorFeeSettings {
  id                    String    @id @default(cuid())
  ghana                 Decimal   @db.Decimal(10, 2)
  ghanaCurrency         String    @default("GHS")
  international         Decimal   @db.Decimal(10, 2)
  internationalCurrency String    @default("USD")
  isActive              Boolean   @default(true)
  description           String?
  paymentMethod         String    @default("Paystack")
  validityDays          Int?
  effectiveDate         DateTime?
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
}

// Author Royalty & Payout system — the Bookstore's real revenue-share
// engine. A RoyaltyLedgerEntry is created once, automatically, the
// moment an order is activated (app/api/orders/[id]/approve/route.js)
// for every item whose book has an author — never hand-entered, and
// never recomputed differently in two places (mirrors the same
// "compute once in lib/, never duplicate the business logic"
// discipline used for GPA and quiz grading elsewhere in this app).
//
// Rate resolution order (see lib/royalty.js resolveRoyaltyRate()):
//   1. Book.royaltyRatePct (a specific book's own negotiated rate)
//   2. AuthorRoyaltyOverride.ratePct (that author's standing rate)
//   3. RoyaltySettings.defaultRatePct (the institution-wide default)
// The rate actually applied is snapshotted onto the ledger entry
// itself, so a later change to any of the three settings above never
// silently rewrites the historical record of what an author was
// really owed and paid for a past sale.
model RoyaltySettings {
  id             String   @id @default(cuid())
  defaultRatePct Decimal  @db.Decimal(5, 2) @default(70.00)
  isActive       Boolean  @default(true)
  effectiveDate  DateTime @default(now())
  description    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// One optional standing override per author, on top of the
// institution-wide default — e.g. a senior author negotiated a
// higher share across their whole catalog.
model AuthorRoyaltyOverride {
  id        String   @id @default(cuid())
  authorId  String   @unique
  ratePct   Decimal  @db.Decimal(5, 2)
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum RoyaltyEntryStatus {
  PENDING
  PAID
  VOID
}

// One row per sold book copy (per OrderItem) — the actual, permanent
// royalty ledger. PENDING until included in a payout (status flips to
// PAID and payoutId is set); VOID if the underlying order is later
// removed (Order -> OrderItem -> RoyaltyLedgerEntry all cascade, so a
// deleted/refunded order can never leave a stale ledger entry
// counted toward an author's balance).
model RoyaltyLedgerEntry {
  id               String             @id @default(cuid())
  authorId         String
  bookId           String
  orderId          String
  orderItemId      String             @unique
  saleAmountUSD    Decimal            @db.Decimal(10, 2)
  royaltyRatePct   Decimal            @db.Decimal(5, 2)
  royaltyAmountUSD Decimal            @db.Decimal(10, 2)
  status           RoyaltyEntryStatus @default(PENDING)
  payoutId         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  author    User          @relation("AuthorRoyaltyLedger", fields: [authorId], references: [id], onDelete: Cascade)
  book      Book          @relation(fields: [bookId], references: [id])
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  payout    AuthorPayout? @relation(fields: [payoutId], references: [id])

  @@index([authorId])
  @@index([bookId])
  @@index([orderId])
  @@index([status])
  @@index([payoutId])
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// Admin-managed payouts of accumulated royalty balance to an author —
// review the ledger, approve, mark paid with a real reference, or
// reject back to pending. Mirrors the same review->approve->complete
// shape already used for Graduation applications and Author
// admissions elsewhere in this app.
model AuthorPayout {
  id                 String       @id @default(cuid())
  authorId           String
  amountUSD          Decimal      @db.Decimal(10, 2)
  method             String?
  reference          String?
  note               String?
  status             PayoutStatus @default(PENDING)
  requestedAt        DateTime     @default(now())
  processedAt        DateTime?
  processedByStaffId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  author        User                 @relation("AuthorPayouts", fields: [authorId], references: [id], onDelete: Cascade)
  ledgerEntries RoyaltyLedgerEntry[]

  @@index([authorId])
  @@index([status])
}

