  updatedAt DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    AcademicTerm?  @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([termId])
  @@index([status])
