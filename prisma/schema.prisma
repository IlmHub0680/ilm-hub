  updatedAt    DateTime @updatedAt

  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([instructorId])
}

enum StudentAdmissionStatus {
  PENDING_PAYMENT
  PAID
  UNDER_REVIEW
  // Model 16: applicant has cleared initial review but this is NOT
  // final admission -- Pending Final Approval still has to happen.
  INITIAL_ACCEPTANCE
  // Model 16: awaiting the final approval decision. Still not final.
  PENDING_FINAL_APPROVAL
  APPROVED
  // Displayed to applicants as "Declined" (see app/admission/track and
  // the admin admissions UI) -- the enum value itself is left as
  // REJECTED rather than renamed, since it is already referenced by
  // real application rows and by status checks throughout the
  // codebase; renaming the value itself is a larger, separate change
  // if wanted later.
  REJECTED
}

enum BookStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  DRAFT
