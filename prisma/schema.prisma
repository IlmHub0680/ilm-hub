generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                   @id @default(uuid())
  name                  String
  email                 String                   @unique
  emailVerified         DateTime?
  passwordHash          String
  role                  Role                     @default(USER)
  authorStatus          AuthorStatus             @default(PENDING)
  preferredLanguage     Language                 @default(EN)
  countryId             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  authoredBooks         Book[]                   @relation("BookAuthor")
  sellingBooks          Book[]                   @relation("BookSeller")
  reviewedBooks         Book[]                   @relation("BookReviewer")

  cart                  Cart?
  courseProgress        CourseProgress[]
  downloadLogs          DownloadLog[]
  enrollments           Enrollment[]
  manuscriptSubmissions ManuscriptSubmission[]
  notifications         Notification[]
  orders                Order[]

  country               Country?                 @relation(fields: [countryId], references: [id])
}

model Country {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  currencyCode   String
  currencySymbol String
  exchangeRate   ExchangeRate?
  users          User[]
}

model ExchangeRate {
  id           String   @id @default(uuid())
  currencyCode String   @unique
  rateToUSD    Decimal  @db.Decimal(12, 6)
  updatedAt    DateTime @updatedAt
  countryId    String   @unique

  country      Country  @relation(fields: [countryId], references: [id])
}

model Category {
  id      String   @id @default(uuid())
  nameEn  String
  nameAr  String
  slug    String   @unique

  books   Book[]
  courses Course[]
}

model Book {
  id              String      @id @default(uuid())
  titleEn         String
  titleAr         String
  slug            String      @unique
  descriptionEn   String
  descriptionAr   String
  priceUSD        Decimal     @db.Decimal(10, 2)
  coverImageUrl   String
  r2FileKey       String
  isFeatured      Boolean     @default(false)
  isNewRelease    Boolean     @default(true)
  categoryId      String
  authorId        String?
  sellerId        String?
  status          BookStatus  @default(APPROVED)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  author          User?       @relation("BookAuthor", fields: [authorId], references: [id])
  seller          User?       @relation("BookSeller", fields: [sellerId], references: [id])
  reviewedBy      User?       @relation("BookReviewer", fields: [reviewedById], references: [id])
  category        Category    @relation(fields: [categoryId], references: [id])

  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([status])
  @@index([sellerId])
  @@index([authorId])
  @@index([reviewedById])
  @@index([categoryId])
  @@index([createdAt])
}

model Course {
  id            String          @id @default(uuid())
  titleEn       String
  titleAr       String
  slug          String          @unique
  descriptionEn String
  descriptionAr String
  isPaid        Boolean         @default(false)
  priceUSD      Decimal         @default(0.00) @db.Decimal(10, 2)
  thumbnailUrl  String
  isPublished   Boolean         @default(false)
  categoryId    String
  createdAt     DateTime        @default(now())

  category      Category        @relation(fields: [categoryId], references: [id])
  sections      CourseSection[]
  enrollments   Enrollment[]
}

model CourseSection {
  id       String    @id @default(uuid())
  titleEn  String
  titleAr  String
  order    Int
  courseId String

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lectures Lecture[]
}

model Lecture {
  id            String         @id @default(uuid())
  titleEn       String
  titleAr       String
  mediaType     MediaType      @default(VIDEO)
  mediaUrl      String
  durationSec   Int            @default(0)
  isFreePreview Boolean        @default(false)
  order         Int
  sectionId     String

  progress      CourseProgress[]
  section       CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String       @id @default(uuid())
  userId    String
  courseId  String
  status    AccessStatus @default(PENDING)
  createdAt DateTime     @default(now())

  course    Course       @relation(fields: [courseId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model CourseProgress {
  id          String   @id @default(uuid())
  userId      String
  lectureId   String
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())

  lecture     Lecture  @relation(fields: [lectureId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, lectureId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  bookId   String
  quantity Int    @default(1)

  book     Book   @relation(fields: [bookId], references: [id])
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  totalUSD        Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @db.Decimal(10, 2)
  currencyCode    String
  exchangeRate    Decimal       @db.Decimal(12, 6)
  status          OrderStatus   @default(ORDER_PLACED)
  paymentMethod   PaymentMethod
  paymentRef      String?
  paymentProofUrl String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  downloadLogs    DownloadLog[]
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  receipt         Receipt?
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  bookId   String
  priceUSD Decimal @db.Decimal(10, 2)

  book     Book    @relation(fields: [bookId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Receipt {
  id        String   @id @default(uuid())
  receiptNo String   @unique
  orderId   String   @unique
  pdfUrl    String
  issuedAt  DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id])
}

model DownloadLog {
  id           String   @id @default(uuid())
  userId       String
  orderId      String
  bookId       String
  downloadedAt DateTime @default(now())
  ipAddress    String

  order        Order    @relation(fields: [orderId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model ManuscriptSubmission {
  id             String             @id @default(uuid())
  authorId       String
  title          String
  genre          String
  description    String
  manuscriptUrl  String
  services       String[]
  status         SubmissionStatus   @default(SUBMITTED)
  quoteAmount    Float?
  quoteDetails   String?
  assignedEditor String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  revisions      ManuscriptRevision[]
  user           User               @relation(fields: [authorId], references: [id])
}

model ManuscriptRevision {
  id           String               @id @default(uuid())
  submissionId String
  fileUrl      String
  notes        String?
  createdAt    DateTime             @default(now())

  submission   ManuscriptSubmission @relation(fields: [submissionId], references: [id])
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
}

model NewsletterCampaign {
  id       String   @id @default(uuid())
  subject  String
  content  String
  category String
  sentAt   DateTime @default(now())
}

enum Role {
  USER
  AUTHOR
  ADMIN
  SUPER_ADMIN
}

enum AuthorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_SUBMITTED
  UNDER_REVIEW
  PENDING_ADMIN_APPROVAL
  APPROVED
  ACTIVATED
  COMPLETED
  REJECTED
}

enum AccessStatus {
  PENDING
  APPROVED
  REVOKED
}

enum PaymentMethod {
  MTN_MOBILE_MONEY
  TELECEL_CASH
  AIRTEL_TIGO_MONEY
  VISA
  MASTERCARD
  BANK_TRANSFER
}

enum Language {
  EN
  AR
}

enum MediaType {
  VIDEO
  AUDIO
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTE_GENERATED
  QUOTE_ACCEPTED
  IN_PRODUCTION
  PUBLISHED
  REJECTED
}