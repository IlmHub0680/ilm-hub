model Request {
  id        String        @id @default(cuid())
  studentId String
  type      RequestType
  status    RequestStatus @default(SUBMITTED)
  details   String

  // Complaint-specific fields (type = COMPLAINT). Left null for the
  // other, pre-existing request types (transcript, deferment, etc).
  topic                 String?
  recipientDepartmentId String?

  // Course add/drop-specific fields (type = COURSE_ADD_DROP). Left null
  // for every other request type. Structured (not parsed from free
  // text) so approving the request can reliably create or remove the
  // real Enrollment row for courseId.
  courseId     String?
  courseAction CourseRequestAction?

  attachmentUrl   String?
  assignedUnitId  String?
  assignedStaffId String?
  responseNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?

  student             StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedUnit        Unit?             @relation(fields: [assignedUnitId], references: [id], onDelete: SetNull)
  recipientDepartment Department?       @relation("RequestRecipientDepartment", fields: [recipientDepartmentId], references: [id], onDelete: SetNull)
  assignedStaff       StaffProfile?     @relation("RequestAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  course              Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  transcriptIssue     TranscriptIssue?
  activities          RequestActivity[]

  @@index([studentId])
  @@index([type])
  @@index([status])
  @@index([assignedUnitId])
  @@index([assignedStaffId])
  @@index([recipientDepartmentId])
}

// One row per meaningful event in a request/complaint's lifecycle —
// submission, assignment, transfer between units, status changes, and
// the final response. This is what lets a student see the full
// "Submitted -> Assigned -> Transferred -> Under Review -> Responded ->
// Closed" progression and transfer history, without overloading the
// single current `status` field.
model RequestActivity {
  id         String         @id @default(cuid())
  requestId  String
  action     String
  // Human-readable snapshots of the recipient before/after this event
  // (e.g. "Department of Computer Science", "Student Affairs"). Plain
  // text rather than a relation because a complaint can move between
  // Units AND Departments, and this is a read-only history trail, not
  // a live reference.
  fromLabel  String?
  toLabel    String?
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  note       String?
  actorLabel String
  createdAt  DateTime       @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

