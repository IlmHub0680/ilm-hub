enum PayslipStatus {
  PENDING
  PAID
}

// A staff member's standing salary structure — the base figure and
// standard allowances Finance sets up once per employee. Payroll
// generation snapshots these into each month's Payslip rather than
// reading this record live, so a later raise never silently rewrites
// an already-issued payslip.
model StaffSalary {
  id         String   @id @default(cuid())
  staffId    String   @unique
  baseSalary Float
  allowances Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff    StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([staffId])
}

// One real, generated payroll record per staff member per calendar
// month. netPay is always server-computed (baseSalary + allowances -
// deductions) — never a manually-typed figure — so the payroll process
// this models is a genuine calculation, not a placeholder display.
model Payslip {
  id         String        @id @default(cuid())
  staffId    String
  salaryId   String?
  year       Int
  month      Int
  baseSalary Float
  allowances Float         @default(0)
  deductions Float         @default(0)
  netPay     Float
  status     PayslipStatus @default(PENDING)
  note       String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  staff  StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  salary StaffSalary? @relation(fields: [salaryId], references: [id], onDelete: SetNull)

  @@unique([staffId, year, month])
  @@index([staffId])
  @@index([status])
  @@index([year, month])
}

// =====================================================================
// LIBRARY
// =====================================================================

model LibraryItem {
  id              String   @id @default(cuid())
  title           String
  author          String
  isbn            String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loans        LibraryLoan[]
  reservations LibraryReservation[]

  @@index([title])
}

enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
}

// Fine tracking lives directly on the loan rather than a separate
// model or Finance's StudentFee: a loan has at most one fine, computed
// from its own overdue duration, so a second table would only add a
// join for no extra capability. It also deliberately stays out of
// Finance's StudentFee/payment flow -- that would require library
// staff (LIBRARY_OPS) to also hold FINANCE_FEES access (or hand off
// to Finance) just to record a paid/waived fine, for a charge that
// never involves a real payment gateway. NONE means the loan has
// never had an overdue fine assessed; UNPAID/PAID/WAIVED track a real
// one once it has.
enum LibraryFineStatus {
  NONE
  UNPAID
  PAID
  WAIVED
}

model LibraryLoan {
  id         String     @id @default(cuid())
  itemId     String
  studentId  String
  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     LoanStatus @default(BORROWED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Renewals -- capped at MAX_RENEWALS (see the renew route) so a loan
  // can't be extended indefinitely; each renewal pushes dueAt forward
  // by a fixed period rather than duplicating a new loan row.
  renewalCount Int @default(0)

  // Fine -- computed (never typed in) from real days-overdue x a flat
  // per-day rate at return/renew/computation time. fineStatus stays
  // NONE until an actual overdue fine is assessed.
  fineAmountUSD  Float             @default(0)
  fineStatus     LibraryFineStatus @default(NONE)
  fineWaivedNote String?
  fineClearedAt  DateTime?

  item        LibraryItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student     StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reservation LibraryReservation?

  @@index([itemId])
  @@index([studentId])
  @@index([status])
  @@index([fineStatus])
}

enum LibraryReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

// A hold placed on an item that has no available copies right now.
// Deliberately its own lightweight model rather than reusing
// LibraryLoan with a "not yet borrowed" status: a reservation has no
// borrowedAt/dueAt/fine of its own, and fulfilledLoanId links it to
// the real loan that's created once the hold is actually issued.
model LibraryReservation {
  id            String                    @id @default(cuid())
  itemId        String
  studentId     String
  requestedAt   DateTime                  @default(now())
  status        LibraryReservationStatus  @default(PENDING)
  fulfilledLoanId String?                 @unique
  fulfilledAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  item          LibraryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fulfilledLoan LibraryLoan?     @relation(fields: [fulfilledLoanId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([studentId])
  @@index([status])
}

// =====================================================================
// ICT SUPPORT
// =====================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  // A ticket that was RESOLVED/CLOSED and got reopened. Kept distinct
  // from OPEN so the ticket's history (and the reopen cap below)
  // can tell "never touched yet" apart from "came back after being
  // marked done" -- an operationally different situation for ICT
  // staff even though both need attention.
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ICTTicket {
  id              String         @id @default(cuid())
  raisedByUserId  String
  subject         String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  // Free-text like LibraryItem.category -- there's no existing fixed
  // category list anywhere in the raise flow or seed data to promote
  // into an enum, so this follows the same free-text pattern already
  // used for LibraryItem.category rather than inventing categories
  // with no basis in the product today.
  category        String?
  assignedStaffId String?
  resolvedAt      DateTime?

  // SLA / response tracking -- set once, the first time an ICT
  // staffer actually engages the ticket (adds a note, or moves it off
  // OPEN/REOPENED), never a placeholder default.
  firstRespondedAt DateTime?

  // Escalation -- a simple flag+timestamp an ICT staffer can set on
  // any open ticket to flag it for senior attention, independent of
  // status/priority.
  escalated   Boolean   @default(false)
  escalatedAt DateTime?

  // Reopening -- bounded rather than unlimited: a ticket can be
  // reopened at most MAX_REOPENS times (see the [id] route) and only
  // within a fixed window after it was last resolved/closed, so a
  // ticket can't be resurrected indefinitely long after the fact.
  reopenedCount Int       @default(0)
  lastReopenedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raisedBy      User          @relation(fields: [raisedByUserId], references: [id], onDelete: Cascade)
  assignedStaff StaffProfile? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  notes         ICTTicketNote[]

  @@index([raisedByUserId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
}

// A running internal log of staff notes on a ticket -- deliberately
// its own model rather than a single overwritable text field, since
// notes need to accumulate (who said what, when), not replace each
// other. Staff-only: never exposed to the student/staff member who
// raised the ticket.
model ICTTicketNote {
  id             String   @id @default(cuid())
  ticketId       String
  authorStaffId  String
  note           String
  // R2 object key (same pattern as the transcript-request attachment
  // flow: lib/r2.ts uploadToR2/getR2PresignedUrl) for an optional
  // file attached to this note -- e.g. a screenshot of the issue or a
  // resolution artifact. Never a public URL; downloaded only via a
  // fresh presigned URL.
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  ticket      ICTTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorStaff StaffProfile @relation(fields: [authorStaffId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorStaffId])
}

model QualityReview {
  id             String         @id @default(cuid())
  subjectType    QASubjectType
  programId      String?
  courseId       String?
  departmentId   String?
  facultyId      String?
  // Set when subjectType = STAFF — an instructor evaluation. Kept on
  // the same model as every other QA review type rather than a
  // parallel "InstructorEvaluation" table, since an instructor
  // evaluation is, in substance, a QualityReview whose subject happens
  // to be a person: same findings/recommendation/status/outcome shape,
  // same reviewer relation, same follow-up mechanism.
  staffId        String?
  reviewType     String
  findings       String
  recommendation String?
  status         QAReviewStatus @default(SCHEDULED)
  outcome        QAOutcome?
  // Real tracking for a recommendation that becomes a required
  // improvement plan, distinct from outcome (which grades the review
  // itself) — NOT_REQUIRED is the default so existing/typical reviews
  // are not misread as having an open plan.
  improvementStatus ImprovementPlanStatus @default(NOT_REQUIRED)
  // Model 11/audit brief -- "Corrective actions... Action owners...
  // Deadlines" are three distinct capabilities; followUpDate below
  // already covers the deadline, but there was no field for WHO owns
  // seeing a corrective action/improvement plan through (distinct
  // from reviewedById, which is who conducted the review itself).
  // Free text, not a StaffProfile FK: the owner is very often a whole
  // unit ("Department of Islamic Studies", "Programme Coordinator")
  // rather than one named person, the same reasoning already used for
  // CourseLearningOutcome.assessmentMethods above.
  actionOwner       String?
  // A lightweight evidence repository: supporting documents (an
  // observation record, a syllabus excerpt, a sample of graded work,
  // a survey export) attached directly to the review they evidence,
  // rather than a separate unlinked document store.
  evidenceUrls   String[]       @default([])
  followUpDate   DateTime?
  reviewedById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  completedAt    DateTime?

  program    Program?      @relation(fields: [programId], references: [id], onDelete: Cascade)
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  faculty    Faculty?      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  staff      StaffProfile? @relation("QAStaffSubject", fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy StaffProfile  @relation("QAReviewer", fields: [reviewedById], references: [id], onDelete: Cascade)

  @@index([subjectType])
  @@index([status])
  @@index([programId])
  @@index([courseId])
  @@index([departmentId])
  @@index([facultyId])
  @@index([staffId])
  @@index([reviewedById])
}

enum QASubjectType {
  PROGRAM
  COURSE
  DEPARTMENT
  FACULTY
  STAFF
}

enum ImprovementPlanStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QAReviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum QAOutcome {
  COMPLIANT
  MINOR_NON_COMPLIANCE
  MAJOR_NON_COMPLIANCE
}

// =====================================================================
// CURRICULUM OUTCOME MAPPING (Model 30 §6)
// Program Learning Outcomes (PLOs) are the institution's approved,
// programme-level outcome statements. Course Learning Outcomes (CLOs)
// belong to a specific course and, when they trace up to a programme
// outcome, record how deeply that course develops it via `depth`.
// `assessmentMethods` stays free text (matching the existing
// Course.assessmentType / outcomeEn convention already used above)
// rather than a rigid FK to Exam/Quiz/Grade -- this is a curriculum
// planning record, not a second live grading pipeline, and the
// institution's real assessment methods are often described in prose
// (e.g. "written exam + Qur'an recitation") rather than resolving
// cleanly to one row in one live table.
// =====================================================================

enum OutcomeDepthLevel {
  INTRODUCED
  DEVELOPED
  REINFORCED
  MASTERED
}

model ProgramLearningOutcome {
  id          String   @id @default(cuid())
  programId   String
  code        String
  statementEn String
  statementAr String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program              Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseLearningOutcomes CourseLearningOutcome[]

  @@unique([programId, code])
  @@index([programId])
}

model CourseLearningOutcome {
  id                String             @id @default(cuid())
  courseId          String
  programLearningOutcomeId String?
  code              String
  statementEn       String
  statementAr       String?
  depth             OutcomeDepthLevel?
  assessmentMethods String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programLearningOutcome ProgramLearningOutcome? @relation(fields: [programLearningOutcomeId], references: [id], onDelete: SetNull)

  @@unique([courseId, code])
  @@index([courseId])
  @@index([programLearningOutcomeId])
}

// =====================================================================
// DUPLICATION / OVERLAP FLAGS (Model 30 §7)
// A lightweight, human-reviewed flag -- never an automatic delete or
// merge. QA (or any staff member with edit access) raises a flag
// naming two possibly-overlapping subjects (two courses, two
// programmes, or two taxonomy categories) and a reviewer resolves it
// with a real, recorded decision.
// =====================================================================

enum DuplicateFlagSubjectType {
  COURSE
  PROGRAM
  CATEGORY
}

enum DuplicateFlagStatus {
  OPEN
  CONFIRMED_DUPLICATE
  NOT_A_DUPLICATE
  MERGED
}

model DuplicateFlag {
  id           String                   @id @default(cuid())
  subjectType  DuplicateFlagSubjectType
  subjectAId   String
  subjectBId   String
  reason       String
  status       DuplicateFlagStatus      @default(OPEN)
  resolutionNote String?
  flaggedById  String
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  flaggedBy  StaffProfile  @relation("DuplicateFlagRaisedBy", fields: [flaggedById], references: [id], onDelete: Cascade)
  resolvedBy StaffProfile? @relation("DuplicateFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([subjectType])
  @@index([status])
  @@index([flaggedById])
}

// =====================================================================
// GRADUATION PROCEDURES
// A standard clearance-style graduation workflow: the student applies
// once eligible, and each relevant office (library, finance, academic
// administration, etc.) independently clears them before the Registrar
// gives final approval and the student's status moves to GRADUATED.
// =====================================================================

model GraduationApplication {
  id           String           @id @default(cuid())
  studentId    String           @unique
  programId    String?
  status       GraduationStatus @default(NOT_STARTED)
  appliedAt    DateTime?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program    Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  clearances GraduationClearance[]
  documents  GraduationDocument[]

  @@index([studentId])
  @@index([programId])
  @@index([status])
}

model GraduationClearance {
  id               String          @id @default(cuid())
  applicationId    String
  unitId           String
  status           ClearanceStatus @default(PENDING)
  note             String?
  clearedByStaffId String?
  clearedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  application    GraduationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  unit           Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  clearedByStaff StaffProfile?         @relation(fields: [clearedByStaffId], references: [id], onDelete: SetNull)

  @@unique([applicationId, unitId])
  @@index([applicationId])
  @@index([unitId])
  @@index([status])
}

enum GraduationStatus {
  NOT_STARTED
  ELIGIBLE
  APPLIED
  CLEARANCE_IN_PROGRESS
  CLEARED
  APPROVED
  REJECTED
  COMPLETED
}

enum ClearanceStatus {
  PENDING
  CLEARED
  FLAGGED
}

enum PlacementStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// A student's official post-graduation documents — issued automatically
// once their GraduationApplication reaches COMPLETED (see the admin
// "complete" action), and regenerated on first request if missing.
model GraduationDocument {
  id               String                 @id @default(cuid())
  applicationId    String
  studentId        String
  type             GraduationDocumentType
  pdfUrl           String
  // Public reference code printed on the certificate/statement PDF
  // -- looked up (exact match only) at the public /verify page
  // (Model 30).
  verificationCode String                 @unique
  issuedAt         DateTime               @default(now())

  application GraduationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  student     StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type])
  @@index([applicationId])
  @@index([studentId])
}

enum GraduationDocumentType {
  CERTIFICATE
  STATEMENT_OF_COMPLETION
}

// ---------------------------------------------------------------------
// Homepage CMS
//
// Makes the public homepage's Hero section, social links, and the
// site-navigation footer link columns admin-editable instead of
// hardcoded in app/page.jsx. Deliberately scoped to plain
// text/link content: the footer's rich modal content (About,
// Contact, Privacy Policy, Terms, Refund Policy, FAQ, Resources)
// stays in code, since making that safely editable would need a
// full rich-text/WYSIWYG system, which is out of scope here.
// Institution-wide Announcements already have their own
// admin-managed model (Announcement, above) and are unaffected.
// ---------------------------------------------------------------------

model HomepageHero {
  id             String   @id @default(cuid())
  badge          String
  title          String
  subtitle       String   @db.Text
  primaryLabel   String
  primaryHref    String
  secondaryLabel String
  secondaryHref  String
  features       String[]
  // Arabic translations (Model 15/16 follow-up) -- all optional. When a
  // field's Arabic version is blank, the public homepage's EN/AR toggle
  // falls back to the English text rather than showing nothing, so this
  // is safe to leave unset until an admin actually fills it in.
  badgeAr          String?
  titleAr          String?
  subtitleAr       String?  @db.Text
  primaryLabelAr   String?
  secondaryLabelAr String?
  featuresAr       String[] @default([])
  // Uploaded brand assets (Model 15/16 follow-up) -- both store a
  // /api/assets/<key> path (see lib/r2.ts + app/api/assets), not a raw
  // R2 key or an external URL. logoUrl is the site's own mark, shown in
  // the header/footer alongside the hero; heroImageUrl is an optional
  // image/photo for the hero banner itself. Both null until an admin
  // uploads one -- the site falls back to the existing text glyph and
  // plain gradient background respectively.
  logoUrl      String?
  heroImageUrl String?
  // Admin-selectable logo size, as a percentage of the header/footer's
  // normal logo size (100 = default). Null until an admin picks a
  // size; the header/footer components clamp this again on read, so
  // no value stored here can ever break their layout.
  logoSize     Int?
  // Optional institute banner image shown behind all three real login
  // pages (Student Portal /login, Staff Portal /staff-login, and the
  // Bookstore/Media/Author /account form). Null until an admin uploads
  // one -- every login page falls back to its existing plain brand
  // gradient background exactly as before. Reuses the same
  // upload/PATCH/clear flow as logoUrl/heroImageUrl above rather than
  // introducing a separate settings model, since this is the same
  // "admin-managed brand asset" concept.
  loginBackgroundUrl String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// Up to 5 rotating banner images for the homepage hero slider
// (Model 25) -- independent of HomepageHero.heroImageUrl, which
// remains the single fallback image shown when no banners here are
// enabled. Reordered / toggled / replaced from
// /admin/homepage/banner-slider; the public homepage only shows
// rows with isActive true, in "order" order.
model HomepageHeroBanner {
  id          String   @id @default(cuid())
  // /api/assets/<key> path from /api/admin/uploads/image, same
  // convention as HomepageHero.heroImageUrl and SectionBanner.imageUrl.
  imageUrl    String
  // Short caption describing this specific banner image -- typed out
  // in the hero headline in sync with the slide, replacing the
  // static HomepageHero.title while banners are active. Optional:
  // an empty caption falls back to HomepageHero.title/titleAr so a
  // banner added without one never leaves the headline blank.
  captionEn   String?
  captionAr   String?
  // Longer, non-animated description for this specific banner --
  // stays fully visible and readable the whole time this slide is
  // showing, never types out like the caption above. Optional: an
  // empty body falls back to HomepageHero.subtitle/subtitleAr the
  // same way an empty caption falls back to the title, so a banner
  // added without one never leaves the paragraph blank. Without this
  // field, admins had nowhere to put a real per-slide description and
  // ended up pasting the whole thing into the caption instead, which
  // is what made the *entire* paragraph type out character by
  // character.
  bodyEn      String?
  bodyAr      String?
  // Hex color (e.g. "#0f4d2c") this banner's slide should tint the
  // hero section toward -- the background gradient and the image's
  // frame both derive from it, so the hero visibly changes color
  // with the slide instead of staying a fixed green. Optional: an
  // empty value keeps the original green gradient/frame.
  accentColor String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Homepage "Welcome", "Academy" and "Our Approach" section text, plus
// the closing "Bismillah" CTA banner (Model 17) -- one singleton row
// covering all four, since each is just a badge/title/subtitle (or,
// for the banner, an Arabic line/title/description) with no repeating
// items of its own. Fixed id "default-homepage-sections", same
// convention as HomepageHero. Admin-editable at /admin/homepage/sections.
model HomepageSectionsText {
  id               String   @id @default(cuid())
  welcomeBadge     String
  welcomeTitle     String
  welcomeSubtitle  String   @db.Text
  academyBadge     String
  academyTitle     String
  academySubtitle  String   @db.Text
  approachBadge    String
  approachTitle    String
  approachSubtitle String   @db.Text
  ctaArabicLine    String
  ctaTitle         String
  ctaDescription   String   @db.Text
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// The four feature cards under the homepage's "Welcome" section
// (icon + title + short text). Same ordered-list pattern as
// AcademyHubCard.
model HomepageFeatureCard {
  id        String   @id @default(cuid())
  icon      String
  title     String
  text      String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// The homepage Academy section's grid of subject icons (icon + short
// label) -- Qur'anic Sciences, Arabic Language, etc.
model HomepageAcademyItem {
  id        String   @id @default(cuid())
  icon      String
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// The homepage's "Our Approach" section's three numbered steps.
model HomepageApproachStep {
  id        String   @id @default(cuid())
  number    String
  title     String
  text      String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// A single uploaded banner image per public section (Model 17) -- the
// same "upload an image, save it independently, it applies
// immediately" pattern as HomepageHero's brand assets, but scoped to
// one section instead of a whole hero. id is the section key itself
// ('bookstore' | 'media' | 'library'), matching HomepageHero's fixed
// 'default-homepage-hero' id -- one row per section, upserted by key,
// never a growing table. Each section's own page keeps its existing
// hardcoded eyebrow/title/subtitle text; only the background image is
// admin-editable here.
//
// titleEn/bodyEn are nullable and, for now, used only by the
// 'homepage-beneficial-knowledge' row (the homepage's "Beneficial
// Knowledge" box -- its heading and paragraph were hardcoded in
// app/page.jsx until this). bookstore/media/library keep their
// existing hardcoded page copy and simply never set these two
// columns, so this stays a single shared model rather than a new one
// per section.
model SectionBanner {
  id        String   @id
  imageUrl  String?
  titleEn   String?
  bodyEn    String?  @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SocialLink {
  id        String   @id @default(cuid())
  name      String
  // A single glyph/character rendered as the button's icon (e.g. "f",
  // "▶", "𝕏", "✈"), matching the existing hardcoded socialLinks array
  // — not an uploaded image or icon-library reference.
  icon      String
  url       String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model FooterLinkGroup {
  id        String       @id @default(cuid())
  title     String
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  links     FooterLink[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([order])
}

model FooterLink {
  id        String          @id @default(cuid())
  groupId   String
  label     String
  href      String
  order     Int             @default(0)
  isActive  Boolean         @default(true)
  group     FooterLinkGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([groupId])
  @@index([order])
}

// The public /academy hub page's hero copy (singleton row, fixed id
// "default-academy-hub-hero", same convention as HomepageHero) and its
// grid of document/programme cards. Admin-editable at /admin/academy-hub.
model AcademyHubHero {
  id        String   @id @default(cuid())
  badge     String
  title     String
  subtitle  String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AcademyHubCard {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String   @db.Text
  href        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// =====================================================================
// PUBLIC EVENTS & NEWS (Model 27)
// Authorized staff manage Events and News from the Admin dashboard;
// only rows with isPublished:true resolve on the public /events and
// /news routes and the homepage's Upcoming Events / Latest News
// sections. Genuinely separate from Announcement (an internal,
// audience-scoped notice board for students/faculty/departments) --
// these are public-facing, richer content types with their own
// images, categories and (for Events) scheduling/location fields, and
// were previously nonexistent rather than duplicated from anywhere.
// =====================================================================

model Event {
  id            String   @id @default(cuid())
  titleEn       String
  titleAr       String?
  descriptionEn String   @db.Text
  descriptionAr String?  @db.Text
  eventDate     DateTime
  eventTime     String?
  // Physical location, or left blank when onlineLink is set (an
  // online-only event) -- both may be filled for a hybrid event.
  location      String?
  onlineLink    String?
  // /api/assets/<key> path from /api/admin/uploads/image, same
  // convention as HomepageHero.heroImageUrl and SectionBanner.imageUrl.
  thumbnailUrl  String?
  // Optional external/registration link ("Register" / "Details").
  detailsLink   String?
  isPublished   Boolean  @default(false)
  createdById   String
  createdBy     User     @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Research & Scholarly Affairs integration (spec model, §17 Research
  // Events) -- additive, nullable so every existing Event row and every
  // existing Event-creation code path keeps working unchanged with no
  // value. Lets a Research-hosted event (conference, seminar, defense,
  // etc.) be created through this SAME existing Event flow and tagged
  // as research-related, instead of Research building a second events
  // platform of its own.
  category      EventCategory?

  @@index([isPublished])
  @@index([eventDate])
  @@index([category])
}

enum EventCategory {
  RESEARCH
  SEMINAR
  CONFERENCE
  WORKSHOP
  GENERAL
}

enum NewsCategory {
  ANNOUNCEMENT
  ACADEMIC
  ADMISSIONS
  COMMUNITY
  ACHIEVEMENT
  GENERAL
}

model NewsArticle {
  id               String       @id @default(cuid())
  titleEn          String
  titleAr          String?
  bodyEnHtml       String       @db.Text
  bodyArHtml       String?      @db.Text
  featuredImageUrl String?
  category         NewsCategory @default(GENERAL)
  isPublished      Boolean      @default(false)
  publishedAt      DateTime?
  createdById      String
  createdBy        User         @relation("NewsCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([publishedAt])
}

// =====================================================================
// LEGAL / INFO PAGES CMS
// About, Privacy Policy, Terms of Use, Refund Policy are long-form
// rich-text pages the Super Admin edits from Admin > Legal & Info
// Pages; FAQ is a managed, ordered list of question/answer pairs;
// Contact is a singleton set of structured contact fields. All are
// read publicly through /api/legal-content, which falls back to
// defaults matching the institute's original hardcoded footer content
// whenever a row is missing — so the public pages never regress.
// =====================================================================

model LegalPage {
  id        String   @id @default(cuid())
  // One of: about, privacy, terms, refund, academy-foundation,
  // academy-governance, academy-pathways, academy-curriculum,
  // academy-department-curriculum, academy-course-catalogue,
  // academy-course-specifications, academy-assessment-grading,
  // academy-student-lifecycle, academy-faculty-portals,
  // academy-academic-regulations, academy-master-integration —
  // enforced at the API layer, not the DB, so no migration is
  // needed to add another page later.
  slug      String   @unique
  title     String
  bodyHtml  String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  // "general" (shown at /faq, the Resources footer link) or
  // "technical" (shown at /it-support, the Technical Support footer
  // link) -- Model 26, so the two FAQ pages can carry genuinely
  // different content instead of both linking to the same list.
  category  String   @default("general")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([category])
}

model ContactInfo {
  id                String   @id @default(cuid())
  address           String?
  poBox             String?
  phone             String?
  whatsapp          String?
  email             String?
  admissionsEmail   String?
  bookstoreEmail    String?
  officeHours       String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// =====================================================================
// QUIZ SYSTEM
// Instructor-authored, timed assessments distinct from Assignment —
// multiple-choice, multiple-select, written and video-based questions,
// server-enforced timing, single-active-attempt handling, and either
// automatic or instructor-reviewed grading. Mirrors the Assignment /
// Submission naming convention already used elsewhere in this schema.
// =====================================================================

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  WRITTEN
  VIDEO
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED
}

model Quiz {
  id                     String   @id @default(cuid())
  courseId               String
  title                  String
  description            String?
  timeLimitMinutes       Int
  startAt                DateTime?
  endAt                  DateTime?
  maxAttempts            Int      @default(1)
  passingScore           Float?
  // Whether a student sees their score/answers right after submitting,
  // vs. only once the instructor releases results (relevant whenever
  // any question needs manual review, but the instructor can also hold
  // back an all-auto-graded quiz's results deliberately).
  showResultsImmediately Boolean  @default(true)
  resultsReleased        Boolean  @default(false)
  isPublished            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id              String           @id @default(cuid())
  quizId          String
  order            Int             @default(0)
  type            QuizQuestionType
  promptText      String           @db.Text
  // For VIDEO questions: the video the student must watch before
  // answering. Nullable for every other question type.
  videoUrl        String?
  points          Float            @default(1)
  // Written (and video-with-written-answer) questions default to
  // needing a human look — SINGLE_CHOICE/MULTIPLE_CHOICE are always
  // machine-gradable regardless of this flag.
  requiresReview  Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@index([order])
}

model QuizOption {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id                     String            @id @default(cuid())
  quizId                 String
  studentId              String
  attemptNumber          Int               @default(1)
  status                 QuizAttemptStatus @default(IN_PROGRESS)
  startedAt              DateTime          @default(now())
  // Server-computed at start time (startedAt + quiz.timeLimitMinutes) —
  // the one deadline every save/submit call is checked against, so the
  // time limit can never be bypassed by editing the frontend countdown.
  expiresAt              DateTime
  submittedAt            DateTime?
  score                  Float?
  maxScore               Float
  // A fresh random value issued every time the student (re)opens this
  // attempt. Autosave/submit calls must present the current token —
  // opening the same attempt in a second tab issues a new token there,
  // so the first tab's stale token is rejected instead of silently
  // overwriting newer answers.
  activeToken            String
  // Best-effort integrity signals — see QuizAttempt.flagCount comment
  // at the API layer for what "strict environment" can and cannot
  // actually enforce from a browser.
  tabSwitchCount         Int               @default(0)
  copyPasteAttemptCount  Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId])
  @@index([studentId])
}

model QuizAnswer {
  id                 String   @id @default(cuid())
  attemptId          String
  questionId         String
  // Selected QuizOption ids, for SINGLE_CHOICE/MULTIPLE_CHOICE.
  selectedOptionIds  String[]
  // Free-text answer, for WRITTEN/VIDEO questions.
  answerText         String?  @db.Text
  score              Float?
  feedback           String?
  gradedAt           DateTime?
  updatedAt          DateTime @updatedAt

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}


// =====================================================================
// INSTRUCTOR PROFILE (Model 10)
// A staff member's qualifications, professional development, and
// performance review history — none of which existed anywhere in the
// schema before this. Kept as their own tables (rather than JSON blobs
// on StaffProfile) since each is a genuine one-to-many history a
// department head, dean, or the instructor themselves needs to browse
// and add to over time.
// =====================================================================

enum QualificationType {
  GENERAL
  ISLAMIC
}

// Staff employment status (Model 21, Section 11) — distinct from the
// plain isActive boolean so HR-relevant nuance (on leave vs. formally
// separated) is visible instead of collapsing to one flag. isActive
// stays the access-control boolean every permission check already
// uses (true for ACTIVE/ON_LEAVE, false for INACTIVE/FORMER); status
// is the descriptive/historical field layered on top. No historical
// teaching/grading/course records are ever deleted when status
// changes — StaffProfile rows are never removed, only marked.
enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  FORMER
}

// Shared by Course and Program (Model 11) — the real approval state
// Academic Governance already named as missing. RETURNED_FOR_REVISION
// is distinct from DRAFT so a coordinator/HOD can see "this was
// reviewed and sent back" rather than confusing it with "never
// submitted."
enum ApprovalStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  RETURNED_FOR_REVISION
}

model StaffQualification {
  id           String            @id @default(cuid())
  staffId      String
  type         QualificationType
  title        String
  institution  String?
  yearObtained Int?
  createdAt    DateTime          @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model StaffDevelopmentRecord {
  id             String    @id @default(cuid())
  staffId        String
  title          String
  provider       String?
  completedAt    DateTime?
  hours          Float?
  certificateUrl String?
  createdAt      DateTime  @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

enum StaffPerformanceRating {
  NEEDS_IMPROVEMENT
  MEETS_EXPECTATIONS
  EXCEEDS_EXPECTATIONS
  OUTSTANDING
}

enum StaffPerformanceReviewStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

// One review cycle's outcome for one staff member. Free-text `period`
// (e.g. "2026 Semester 1") rather than a relation to AcademicTerm,
// since a performance review cycle applies to all staff, not only
// those tied to a specific student-facing term.
model StaffPerformanceReview {
  id             String                       @id @default(cuid())
  staffId        String
  reviewerId     String
  period         String
  rating         StaffPerformanceRating?
  strengths      String?
  areasForGrowth String?
  status         StaffPerformanceReviewStatus @default(DRAFT)
  reviewedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  staff    StaffProfile @relation("StaffPerformanceReviewee", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer StaffProfile @relation("StaffPerformanceReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([reviewerId])
}

// =====================================================================
// COURSE EVALUATIONS (Model 10)
// A real, minimal student-submitted course evaluation — no such
// system existed before this. One submission per student per course
// per term; QA reads these aggregated, never attributed by name when
// isAnonymous is true (enforced at the API layer).
// =====================================================================

model CourseEvaluation {
  id               String        @id @default(cuid())
  studentId        String
  courseId         String
  termId           String?
  ratingOverall    Int
  ratingContent    Int?
  ratingInstructor Int?
  comments         String?
  isAnonymous      Boolean       @default(true)
  createdAt        DateTime      @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term    AcademicTerm?  @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId, termId])
  @@index([courseId])
  @@index([termId])
}

// =====================================================================
// ACADEMIC INTEGRITY (Model 11)
// The real system behind the academic integrity paragraph already
// drafted, but marked "proposed, not yet founder-confirmed," in Course
// Specifications' Foundation-tier common policies. No case-tracking of
// any kind existed before this — violations could only be described in
// free text through the generic Request/Complaint mechanism, with
// nothing to query, no severity, and no sanction record.
// =====================================================================

enum IntegrityViolationType {
  PLAGIARISM
  CHEATING
  UNAUTHORIZED_COLLABORATION
  FALSIFICATION
  IMPERSONATION
  ASSESSMENT_MISCONDUCT
  AI_MISUSE
  OTHER
}

enum IntegrityCaseSeverity {
  MINOR
  MAJOR
}

enum IntegrityCaseStatus {
  REPORTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model IntegrityCase {
  id             String                 @id @default(cuid())
  studentId      String
  courseId       String?
  violationType  IntegrityViolationType
  severity       IntegrityCaseSeverity  @default(MINOR)
  description    String
  reportedById   String
  status         IntegrityCaseStatus    @default(REPORTED)
  // What was actually applied — free text since real sanctions vary
  // (a resubmission, a grade penalty, a course fail) rather than a
  // fixed catalogue this document would otherwise have to invent.
  sanction       String?
  // True only when this case actually moved the student through the
  // existing AcademicStanding process (§9's drafted policy already
  // anticipates this for a repeat/severe case) — never a second,
  // competing standing mechanism of its own.
  standingActionTaken Boolean           @default(false)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reportedBy StaffProfile   @relation("IntegrityCaseReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy StaffProfile?  @relation("IntegrityCaseResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([courseId])
  @@index([reportedById])
  @@index([status])
}

// =====================================================================
// AI ASSISTANT
// The assistant's own rule-based logic, knowledge base and zone/menu
// system live in code (lib/assistantKnowledge.js, lib/assistantI18n.js,
// app/api/assistant/route.js) -- these two models hold only what
// genuinely has to be data: an admin-editable settings singleton, and a
// minimal, non-identifying interaction log (never raw message text, so
// this is safe to keep indefinitely without becoming a privacy record
// of what any one person asked).
// =====================================================================

model AssistantSettings {
  id                 String   @id @default(cuid())
  isEnabled          Boolean  @default(true)
  welcomeMessageEn   String?  @db.Text
  welcomeMessageAr   String?  @db.Text
  supportedLanguages String[] @default(["en", "ar"])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AssistantEvent {
  id        String   @id @default(cuid())
  // 'open' | 'identity_selected' | 'language_selected' | 'quick_option'
  // | 'query_matched' | 'query_unmatched'
  type      String
  zone      String?
  identity  String?
  language  String?
  // A quick-option label or matched knowledge-entry id only -- never
  // the visitor's raw typed message.
  label     String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// =====================================================================
// ULUL AZM COMMUNITY
// Student-wide, cross-course discussion space -- distinct from the
// existing course-scoped Discussion/DiscussionComment models (which
// stay exactly as they are, for in-course exercise discussion). Kept
// deliberately modest: posts, comments, light moderation via isHidden.
// Reachable from inside the existing Student Portal (/academics), not
// as a new top-level system.
// =====================================================================

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  body      String   @db.Text
  category  String   @default("GENERAL")
  isPinned  Boolean  @default(false)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  reports  CommunityReport[]

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
}

model CommunityComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  reports CommunityReport[]

  @@index([postId])
  @@index([authorId])
}

// Optional, Community-only profile info layered on top of an existing
// User/StudentProfile -- never a duplicate of academic data. Bio,
// interests and a display photo are genuinely new fields Community
// needs; department, program and "alumni" status are NOT duplicated
// here -- they're read live from the user's own StudentProfile
// (department/program relations, status === 'GRADUATED' for alumni)
// by the API that serves a Community profile, exactly per Model 25's
// instruction not to give alumni a second, competing identity.
// One row per user, created lazily the first time someone edits their
// Community profile -- most members will simply never have one, and
// that's the normal/default state (fall back to User.name/avatarUrl).
model CommunityProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?  @db.Text
  interests String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Member-to-member block for the Community (Model 25 §7). One-directional
// by design (A blocks B does not require B's consent or notify them) --
// the API applying this must hide each side from the other in both
// directions when checking for an existing block, but the row itself
// only ever represents the blocker's action.
model CommunityBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())

  blocker User @relation("CommunityBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("CommunityBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  OTHER
}

// Member-submitted content report (Model 25 §8) -- exactly one of
// postId/commentId is set, matching whichever the reporter flagged.
// Landing status is always OPEN; a moderator (same STUDENT_MATTERS
// permission already used for hide/pin) reviews and closes it as
// REVIEWED or DISMISSED from a dedicated admin queue, distinct from
// the in-page hide/pin controls that already existed before this.
model CommunityReport {
  id           String                  @id @default(cuid())
  reporterId   String
  postId       String?
  commentId    String?
  reason       CommunityReportReason
  details      String?                 @db.Text
  status       CommunityReportStatus   @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())

  reporter   User              @relation("CommunityReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("CommunityReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([postId])
  @@index([commentId])
  @@index([status])
}

// Model 25 addendum: mandatory Community Guidelines acknowledgment.
// One row per user, keyed by a hash of the guidelines content they
// actually agreed to (see lib/community.js communityGuidelinesContent) --
// so "require re-acceptance when the guidelines are updated" falls out
// naturally from comparing hashes, instead of a manual version counter
// an admin has to remember to bump.
model CommunityGuidelinesAcceptance {
  id          String   @id @default(cuid())
  userId      String   @unique
  contentHash String
  acceptedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Model 26 (Admin, RBAC & Institutional Governance) -- a general
// cross-cutting audit trail for sensitive operations that had NO
// audit trail at all: Community moderation actions (hide/pin, report
// resolution) and graduation clearance/approval/document-finalization
// decisions. Deliberately NOT used for admission decisions (already
// captured in full by AdmissionAuditLog) or grade corrections (already
// captured in full by GradeCorrection) -- those two are genuinely
// solid and are read alongside this table by the unified Audit Log
// viewer (app/api/admin/audit-log/route.js) instead of being
// duplicated into a second table.
enum AuditCategory {
  DOCUMENT_FINALIZATION
  ACADEMIC_RECORD_ADJUSTMENT
  COMMUNITY_MODERATION
  OTHER
}

model AuditLog {
  id          String        @id @default(cuid())
  actorUserId String?
  actorName   String
  actorRole   String
  department  String?
  module      Module?
  action      String
  category    AuditCategory
  targetType  String?
  targetId    String?
  summary     String        @db.Text
  metadata    Json?
  createdAt   DateTime      @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([category])
  @@index([module])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// =====================================================================
// PAGE FEEDBACK -- lightweight "was this page helpful?" widget used on
// informational pages (IT Department, Safe Usage Policy, and any page
// that adds <PageFeedback/>). One row per submission; pageSlug says
// which page it came from. No admin viewer yet -- rows are just kept
// for whenever staff want to review them directly in the database.
// =====================================================================

model PageFeedback {
  id        String   @id @default(cuid())
  pageSlug  String
  response  String
  createdAt DateTime @default(now())

  @@index([pageSlug])
}


// =====================================================================
// RESEARCH & SCHOLARLY AFFAIRS (spec Model §17) -- a Delegated
// Operation: a real institute department run by its own designated
// role (Research & Scholarly Affairs Officer, RESEARCH_OPS module),
// never an Admin-operated function. Admin's own surface is read-only
// oversight at app/admin/research (see that page for the copy
// convention already used for every other delegated operation).
//
// Scholarly Publications is entirely its own model here -- zero
// coupling to the personal ManuscriptSubmission/Book publishing
// pipeline, which stays untouched.
//
// Research Integrity is deliberately a separate model from
// IntegrityCase (student academic integrity in a course context):
// ResearchIntegrityCase tracks misconduct by a RESEARCHER in a
// RESEARCH PROJECT/PUBLICATION context (authorship disputes, data
// fabrication, ethics violations) and carries its own strict
// permission gate at the application layer.
//
// Research Funding tracks grant records only -- Finance remains
// responsible for actual financial transactions; no money-movement
// logic lives here.
//
// Research Supervision is built fully at the schema/API layer (no
// research-based programme is currently seeded -- see ProgramLevel/
// Program comments elsewhere in this file), so it exists and is
// ready; its dashboard UI is kept a light, honest empty-state
// scaffold given zero real usage today.
// =====================================================================

enum ResearchProjectStatus {
  PROPOSED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  COMPLETED
  REJECTED
  SUSPENDED
}

enum ResearchProposalStatus {
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ResearchReviewDecision {
  PENDING
  APPROVE
  REQUEST_REVISION
  REJECT
}

enum ResearchProposalDecisionType {
  SUBMITTED
  REVIEWER_ASSIGNED
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ResearchTeamRole {
  PRINCIPAL_INVESTIGATOR
  CO_INVESTIGATOR
  RESEARCHER
  RESEARCH_ASSISTANT
  EXTERNAL_COLLABORATOR
}

enum ResearchPublicationType {
  JOURNAL_ARTICLE
  BOOK
  BOOK_CHAPTER
  CONFERENCE_PAPER
  RESEARCH_REPORT
  WORKING_PAPER
  OTHER
}

enum ResearchPublicationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PUBLISHED
  RETRACTED
}

enum ResearchSupervisionStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  DISCONTINUED
}

enum ResearchGrantStatus {
  APPLIED
  AWARDED
  DECLINED
  ACTIVE
  CLOSED
}

enum ResearchIntegrityConcernType {
  PLAGIARISM
  DATA_FABRICATION
  AUTHORSHIP_DISPUTE
  ETHICS_VIOLATION
  CONFLICT_OF_INTEREST
  OTHER
}

enum ResearchIntegrityCaseStatus {
  REPORTED
  UNDER_INVESTIGATION
  RESOLVED
  DISMISSED
}

model ResearchArea {
  id          String   @id @default(cuid())
  nameEn      String   @unique
  nameAr      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects   ResearchProject[]
  proposals  ResearchProposal[]
}

model ResearchProject {
  id                       String                @id @default(cuid())
  title                    String
  description              String
  areaId                   String?
  principalInvestigatorId  String
  status                   ResearchProjectStatus @default(PROPOSED)
  startDate                DateTime?
  endDate                  DateTime?
  progressNotes            String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  area                  ResearchArea?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  principalInvestigator StaffProfile           @relation("ResearchProjectPI", fields: [principalInvestigatorId], references: [id], onDelete: Restrict)
  milestones            ResearchMilestone[]
  teamMembers           ResearchTeamMember[]
  proposal              ResearchProposal?
  publications          ResearchPublication[]
  partners              ResearchProjectPartner[]
  grants                ResearchGrant[]
  integrityCases        ResearchIntegrityCase[]

  @@index([areaId])
  @@index([principalInvestigatorId])
  @@index([status])
}

model ResearchMilestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ResearchTeamMember {
  id                   String           @id @default(cuid())
  projectId            String
  staffId              String?
  externalName         String?
  externalAffiliation  String?
  externalEmail        String?
  role                 ResearchTeamRole @default(RESEARCHER)
  joinedAt             DateTime         @default(now())

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staff   StaffProfile?   @relation("ResearchTeamMemberStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([staffId])
}

model ResearchProposal {
  id            String                  @id @default(cuid())
  title         String
  summary       String
  areaId        String?
  submittedById String
  projectId     String?                 @unique
  status        ResearchProposalStatus  @default(SUBMITTED)
  submittedAt   DateTime                @default(now())
  decidedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  area        ResearchArea?              @relation(fields: [areaId], references: [id], onDelete: SetNull)
  submittedBy StaffProfile               @relation("ResearchProposalSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  project     ResearchProject?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reviews     ResearchProposalReview[]
  decisions   ResearchProposalDecision[]

  @@index([areaId])
  @@index([submittedById])
  @@index([status])
}

model ResearchProposalReview {
  id           String                 @id @default(cuid())
  proposalId   String
  reviewerId   String
  assignedAt   DateTime               @default(now())
  comments     String?
  revisionNote String?
  decision     ResearchReviewDecision @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  proposal ResearchProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  reviewer StaffProfile     @relation("ResearchProposalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([reviewerId])
  @@index([decision])
}

model ResearchProposalDecision {
  id         String                       @id @default(cuid())
  proposalId String
  type       ResearchProposalDecisionType
  actorId    String?
  note       String?
  createdAt  DateTime                     @default(now())

  proposal ResearchProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actor    StaffProfile?    @relation("ResearchProposalDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([actorId])
}

model ResearchPublication {
  id           String                     @id @default(cuid())
  projectId    String?
  type         ResearchPublicationType
  status       ResearchPublicationStatus  @default(DRAFT)
  title        String
  venue        String?
  publisher    String?
  year         Int?
  doiOrLink    String?
  abstract     String?
  isPublic     Boolean                    @default(false)
  publishedAt  DateTime?
  createdById  String
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  project        ResearchProject?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      StaffProfile                  @relation("ResearchPublicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  authors        ResearchPublicationAuthor[]
  integrityCases ResearchIntegrityCase[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([type])
}

model ResearchPublicationAuthor {
  id             String  @id @default(cuid())
  publicationId  String
  staffId        String?
  externalName   String?
  order          Int     @default(0)

  publication ResearchPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  staff       StaffProfile?       @relation("ResearchPublicationAuthorStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([staffId])
}

model ResearchCollaborationPartner {
  id           String   @id @default(cuid())
  name         String
  type         String?
  country      String?
  contactName  String?
  contactEmail String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects ResearchProjectPartner[]
}

model ResearchProjectPartner {
  id        String   @id @default(cuid())
  projectId String
  partnerId String
  role      String?
  createdAt DateTime @default(now())

  project ResearchProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner ResearchCollaborationPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([projectId, partnerId])
  @@index([projectId])
  @@index([partnerId])
}

model ResearchSupervision {
  id             String                    @id @default(cuid())
  studentId      String
  supervisorId   String
  topic          String
  status         ResearchSupervisionStatus @default(ACTIVE)
  startedAt      DateTime                  @default(now())
  completedAt    DateTime?
  progressNotes  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  student     StudentProfile                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supervisor  StaffProfile                   @relation("ResearchSupervisionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  coSupervisors ResearchCoSupervisor[]
  meetings    ResearchSupervisionMeeting[]

  @@index([studentId])
  @@index([supervisorId])
  @@index([status])
}

model ResearchCoSupervisor {
  id             String @id @default(cuid())
  supervisionId  String
  staffId        String

  supervision ResearchSupervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)
  staff       StaffProfile        @relation("ResearchCoSupervisorStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([supervisionId, staffId])
  @@index([supervisionId])
  @@index([staffId])
}

model ResearchSupervisionMeeting {
  id            String   @id @default(cuid())
  supervisionId String
  meetingDate   DateTime @default(now())
  notes         String
  createdAt     DateTime @default(now())

  supervision ResearchSupervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  @@index([supervisionId])
}

model ResearchGrant {
  id              String              @id @default(cuid())
  projectId       String
  fundingSource   String
  amountRequested Decimal?            @db.Decimal(12, 2)
  amountAwarded   Decimal?            @db.Decimal(12, 2)
  currency        String              @default("USD")
  status          ResearchGrantStatus @default(APPLIED)
  appliedAt       DateTime            @default(now())
  decidedAt       DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  project ResearchProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reports ResearchGrantReport[]

  @@index([projectId])
  @@index([status])
}

model ResearchGrantReport {
  id         String   @id @default(cuid())
  grantId    String
  reportDate DateTime @default(now())
  notes      String
  createdAt  DateTime @default(now())

  grant ResearchGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

// Strict permissions: only the Research role holder and Admin/
// SUPER_ADMIN may ever view/create/resolve these records (enforced in
// app/api/research/integrity routes, not at the database layer).
model ResearchIntegrityCase {
  id                 String                       @id @default(cuid())
  projectId          String?
  publicationId      String?
  concernType        ResearchIntegrityConcernType
  description        String
  reportedById       String
  status             ResearchIntegrityCaseStatus  @default(REPORTED)
  investigationNotes String?
  outcome            String?
  isConfidential     Boolean                      @default(true)
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  project     ResearchProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  publication ResearchPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  reportedBy  StaffProfile         @relation("ResearchIntegrityCaseReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy  StaffProfile?        @relation("ResearchIntegrityCaseResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([publicationId])
  @@index([reportedById])
  @@index([status])
}
