-- ============================================================
-- 17. Staff leadership/coordinator relationships
-- ============================================================

ALTER TABLE "Faculty"
ADD CONSTRAINT "Faculty_deanId_fkey"
FOREIGN KEY ("deanId")
REFERENCES "StaffProfile"("id")
ON DELETE SET NULL
ON UPDATE CASCADE;

ALTER TABLE "Department"
ADD CONSTRAINT "Department_headId_fkey"
FOREIGN KEY ("headId")
REFERENCES "StaffProfile"("id")
ON DELETE SET NULL
ON UPDATE CASCADE;

ALTER TABLE "Program"
ADD CONSTRAINT "Program_coordinatorId_fkey"
FOREIGN KEY ("coordinatorId")
REFERENCES "StaffProfile"("id")
ON DELETE SET NULL
ON UPDATE CASCADE;
