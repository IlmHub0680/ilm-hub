-- ============================================================
-- 13. Admission -> Program relationship
-- ============================================================

ALTER TABLE "AdmissionApplication"
ADD CONSTRAINT "AdmissionApplication_programId_fkey"
FOREIGN KEY ("programId")
REFERENCES "Program"("id")
ON DELETE RESTRICT
ON UPDATE CASCADE;

-- ============================================================
-- 14. Validate formal programme admissions
--
-- Private-course admissions may have NULL programId.
-- Every PROGRAM admission must have a valid programme.
-- ============================================================

DO $$
DECLARE
    invalid_count INTEGER;
BEGIN
    SELECT COUNT(*)
    INTO invalid_count
    FROM "AdmissionApplication"
    WHERE "admissionType" = 'PROGRAM'
      AND "programId" IS NULL;

    IF invalid_count > 0 THEN
        RAISE EXCEPTION
            'Migration aborted: % PROGRAM admissions have no programId.',
            invalid_count;
    END IF;
END
$$;

